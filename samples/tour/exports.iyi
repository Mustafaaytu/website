# `import x::{...}`: bring a module's exported names in, unqualified.

# The whole surface with `::*`, or a chosen few in braces. Either way it is
# this file that asks: a library cannot put names into a file that did not.
import geometry/point::{Point, distance}

home = Point.new(0, 0)
work = Point.new(3, 4)
puts distance(home, work)

# `secret` was declared without `pub`, so it is not there to be found.
# Uncomment the next line to see the compiler say so:
# puts Geometry::Point.secret
