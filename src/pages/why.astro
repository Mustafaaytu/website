---
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import Measure from "../components/Measure.astro";
import Stamped from "../components/Stamped.astro";
import DurationChart from "../components/DurationChart.astro";
import Quote from "../components/Quote.astro";
import facts from "../generated/facts.json";
import platforms from "../generated/targets.json";
import proofs from "../generated/proofs.json";
import { SPELLED } from "../lib/lessons";
import mascot from "../assets/mascot.png";

const base = import.meta.env.BASE_URL;
const loop = facts.recorded.edit_loop;
const bin = facts.recorded.hello_binary;
const front = facts.recorded.front_end;
const pack = facts.recorded.context_pack;
const runtime = facts.recorded.runtime;
const lib = facts.recorded.library_size;

const ratios = loop.ratios as number[];
const loopBand = `${Math.min(...ratios).toFixed(2)}x to ${Math.max(...ratios).toFixed(2)}x across ${loop.sessions.length} published sessions. The seconds moved; the ratio held, which is why the ratio is the claim.`;

/* The hello binary at true area: Crystal's square is the plot, and iyi's is
 * the square whose area is the measured fraction of it. Drawn by width it
 * would flatter the smaller number. */
const massRatio = bin.crystal.kb / bin.iyi.kb;
const plotSide = 158;
const iyiSide = plotSide / Math.sqrt(massRatio);
const startRatio = (bin.crystal.ms / bin.iyi.ms).toFixed(1);

const stringRow = runtime.rows.find((r) => r.workload === "string building");
if (!stringRow) {
  throw new Error("why: bench/runtime.py recorded no string building row, so there is no loss to name");
}

/* The platforms, out of scripts/targets.mjs: the list the workflow
 * type-checks and the subset README.md says is run every build. The ones that
 * run are listed first. */
const ran = new Set(platforms.ran);
const targets = [
  ...platforms.typechecked.filter((t) => ran.has(t)),
  ...platforms.typechecked.filter((t) => !ran.has(t)),
];
const ranCount = SPELLED[platforms.ran.length] ?? String(platforms.ran.length);
const ranHow = platforms.ran.map((t) => platforms.how[t as keyof typeof platforms.how]);

/* The object audit and the Windows jobs, as the live page states them: the
 * audit count and its exceptions read out of README.md by
 * scripts/targets.mjs, the Windows jobs counted out of the workflow by
 * scripts/proofs.mjs, so neither is typed here. */
const auditedCount = SPELLED[platforms.audited.length] ?? String(platforms.audited.length);
const exempt = platforms.auditExempt;
const onWindows = proofs.native.filter((job) => job.os === "windows");
const gatedOnWindows = onWindows.filter((job) => proofs.gate.needs.includes(job.id));

/* The modules a rebuild did not read: the bench project's module count, less
 * the one whose line changed, spelled through the same table as the rest of
 * the site so the sentence follows the tree. */
const rest = facts.structural.modules - 1;
const untouched = SPELLED[rest] ?? String(rest);

/* Four of the moves, said shortly. The whole table is README.md's, and the
 * page says so under the list. */
const moves = [
  { from: 'require "foo"', to: "import app/foo", why: "A module has a name, and its path is its file's path.", rule: "R-1" },
  { from: "a required file's names are just there", to: "import app/foo::{bar}", why: "The consumer writes what comes in. A library cannot take a name in your file.", rule: "R-2b" },
  { from: "reopen any class, even String", to: "you may not reopen", why: "What a type is, is settled where it is written.", rule: "R-3" },
  { from: "public unless private", to: "private unless pub, and pub writes its types", why: "Exports carry full types; everything inside still infers.", rule: "R-2" },
];

const shards = ["kemal", "db", "ameba", "sqlite3"];
---

<Page
  kind="TechArticle"
  title="Why iyi"
  summary={`iyi runs your Crystal code today and rebuilds it ${loop.claim.value}x faster. Developer experience, agent experience, portability, performance and efficiency: four sides of one rule, every number measured.`}
>
  <div class="wrap">
    <section class="page-hero why-hero">
      <p class="eyebrow">
        <Image src={mascot} alt="" width={20} height={19} densities={[1, 2]} loading="eager" decoding="async" />
        Why iyi
      </p>
      <h1 class="h1">
        Your Crystal code, rebuilt {loop.claim.value}x faster, with a compiler your agents can talk to.
      </h1>
      <p class="lead">
        One design decision seen from four sides: a module compiles against
        its dependencies' declarations, never their bodies. Every number on
        this page was measured by a gate in the repository.
      </p>
    </section>

    <nav class="sides" aria-label="The four sides">
      <a href="#dx">
        <span class="sides-n">1 · Developer experience</span>
        <b>{loop.claim.value}x</b>
        <span>faster on the line you just changed</span>
      </a>
      <a href="#ai">
        <span class="sides-n">2 · Agent experience (AX)</span>
        <b>{pack.tokens_low}–{pack.tokens_high}%</b>
        <span>fewer prompt tokens per edit</span>
      </a>
      <a href="#portability">
        <span class="sides-n">3 · Portability</span>
        <b><Measure of="targets" /></b>
        <span>targets, {ranCount} run every build</span>
      </a>
      <a href="#performance">
        <span class="sides-n">4 · Performance</span>
        <b>{Math.round(massRatio)}x</b>
        <span>smaller hello world</span>
      </a>
    </nav>

    <section class="sec split">
      <div class="sec__head">
        <p class="eyebrow">First</p>
        <h2 class="h2">It runs your Crystal code. Today.</h2>
        <p class="p">
          iyi's compiler is Crystal's compiler. Your .cr files build unchanged,
          and <code>iyi build --crystal</code> brings Crystal's standard
          library, <code>require</code>, and your shards. There is no port to
          do first.
        </p>
      </div>
      <ul class="compat">
        {
          shards.map((shard) => (
            <li>
              <code>{shard}</code>
              <span class="chip chip--ok">builds and runs</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec" id="moved">
      <div class="sec__head">
        <p class="eyebrow">Coming from Crystal</p>
        <h2 class="h2">What moved, and why.</h2>
        <p class="p">
          The syntax is Crystal's. What moved is where things may be written.
          Macros are kept, and they travel in the artifact; nil, union types,
          blocks and local inference are kept, unchanged.
        </p>
      </div>
      <ol class="moves">
        {
          moves.map((move) => (
            <li>
              <code class="moves-from">{move.from}</code>
              <span class="moves-arrow" aria-hidden="true">→</span>
              <code class="moves-to">{move.to}</code>
              <span class="moves-why">{move.why}</span>
              <span class="chip chip--red">{move.rule}</span>
            </li>
          ))
        }
      </ol>
      <p class="small">
        Four of the moves, condensed from README.md. Traits are step 4 of{" "}
        <a href={`${base}learn/#step-4`}>Learn</a>; shards and{" "}
        <code>iyi migrate</code> are in the README.
      </p>
    </section>

    <section class="sec" id="dx">
      <div class="sec__head">
        <p class="eyebrow">1 · Developer experience</p>
        <h2 class="h2">The loop you are actually in is the loop that got fast.</h2>
        <p class="p">
          Change one line in a <Measure of="generated" />-line project and
          rebuild. iyi reads the declarations of the other {untouched} modules
          and none of their bodies, on the same compiler binary.
        </p>
      </div>
      <Stamped claim={`About ${loop.claim.value}x less`} band={loopBand} subject={`${loop.subject} · bars run at real speed`} outcome="win">
        <button slot="action" type="button" class="copy replay" data-replay>
          <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M10 6a4 4 0 1 1-1.2-2.85M10 1.5v2.2H7.8" /></svg>
          Replay
        </button>
        <DurationChart slot="figure" />
      </Stamped>
      <div class="trio">
        <div>
          <strong>Errors name the rule, and the fix.</strong>
          <p class="p">A refusal says which rule it enforces and writes out the line you meant.</p>
        </div>
        <div>
          <strong>A framework's promise is checked at your line.</strong>
          <p class="p">
            A Kemal port refuses a handler whose return a body cannot be made
            of. Kemal accepts the same block and serves an empty body forever.
          </p>
        </div>
        <div>
          <strong>The tools are the compiler.</strong>
          <p class="p">
            <code>iyi lsp</code> answers from the front end a build uses, so
            the build, <code>iyi check</code> and your editor cannot disagree.
          </p>
        </div>
      </div>
      <Quote id="bad_body" as="diagnostic" caption="The Kemal port refusing a handler" />
    </section>

    <section class="sec split" id="ai">
      <div class="sec__head">
        <p class="eyebrow">
          {/* The address this section had before the redesign, kept so a
              link to it still lands here. Inline and empty, so it takes no
              cell of the grid. */}
          <span id="aix"></span>2 · Agent experience (AX)
        </p>
        <h2 class="h2">A compiler built to be an agent's tool, not wrapped as one.</h2>
        <p class="p">
          A <code>.iyimod</code> holds a module's declarations, with every type
          written down, and its machine code. A tool can read exactly what a module offers without
          the repository, and check a change against it without building the
          world.
        </p>
        <p class="p">
          <code>iyi mod diff</code> answers "did my change reach anybody?"
          Rename a local and the interface is unchanged.{" "}
          <code>--exit-code</code> makes that a branch in a script, or in an
          agent's plan.
        </p>
        <p class="p">
          The mechanism is built and the claim is young. If the rules turn out
          not to be enough for agents, that is a thing to measure rather than
          to promise.
        </p>
        <a class="link" href={`${base}agents/`}>See the agent loop, recorded →</a>
      </div>
      <Quote id="mod_diff" as="console" caption="iyi mod diff" />
    </section>

    <section class="sec split" id="portability">
      <div class="sec__head">
        <p class="eyebrow">3 · Portability</p>
        <h2 class="h2">Compiles for <Measure of="targets" />. Runs on {ranCount}, every build.</h2>
        <p class="p">
          CI type-checks the library for all <Measure of="targets" /> on every
          push, and runs {ranCount}: the check is that they print what the
          same program printed where it was compiled. The wasm32 build is one
          self-contained module, which is why the{" "}
          <a href={`${base}playground/`}>tour</a> runs in your browser.
        </p>
        <p class="p">
          The {ranCount} that run are {ranHow.join(", ")}. Of the{" "}
          <Measure of="targets" />, {auditedCount} have the object they emit
          audited for what it asks the machine for;{" "}
          {
            exempt.map((t, i) => (
              <>{i === 0 ? "" : i === exempt.length - 1 ? " and " : ", "}<code>{t}</code></>
            ))
          }{" "}
          are not. Windows is not in the {ranCount}, and is no longer only
          compiled for either: {onWindows.length} jobs execute on a Windows
          machine every build, and{" "}
          {gatedOnWindows.length === onWindows.length ? "every one" : `${gatedOnWindows.length} of them`}{" "}
          is on the list a tag waits for, so a failure there stops a release.
          The <a href={`${base}targets/`}>platforms page</a> names them with
          their lines.
        </p>
      </div>
      <ul class="targets">
        {
          targets.map((t) => (
            <li>
              <code>{t}</code>
              {ran.has(t) ? <span class="ok">● runs</span> : <span class="faint">○ compiles</span>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec" id="performance">
      <div class="sec__head">
        <p class="eyebrow">4 · Performance and efficiency</p>
        <h2 class="h2">Native code, a small program, and a front end that answers before you notice.</h2>
        <p class="p">
          iyi generates native code through LLVM. At run time the two
          libraries are within noise where they do the same work. What changes
          is what a program carries: it links only what it uses, and iyi's own
          library is <Measure of="prelude" /> lines against Crystal's{" "}
          {lib.crystal.toLocaleString("en-GB")}, <Measure of="prelude_kb" unit="KB" />{" "}
          on disk beside the binary.
        </p>
      </div>
      <div class="split">
        <Stamped
          claim={`${Math.round(massRatio)}x smaller`}
          band={`and starts ${startRatio}x sooner.`}
          subject={`${bin.subject}, drawn at true area`}
          outcome="win"
        >
          <button slot="action" type="button" class="copy replay" data-replay>
            <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M10 6a4 4 0 1 1-1.2-2.85M10 1.5v2.2H7.8" /></svg>
            Replay
          </button>
          <div slot="figure" class="area" data-area>
            <div
              class="area-plot"
              role="img"
              aria-label={`iyi's ${bin.iyi.kb} KB drawn inside Crystal's ${bin.crystal.kb.toLocaleString("en-GB")} KB, at true area`}
              style={`width:${plotSide}px;height:${plotSide}px`}
            >
              <span class="area-crystal" data-side={plotSide} style={`width:${plotSide}px;height:${plotSide}px`}></span>
              <span class="area-iyi" data-side={iyiSide} style={`width:${iyiSide}px;height:${iyiSide}px`}></span>
            </div>
            <dl class="area-legend">
              <div>
                <dt><i class="sw sw--iyi"></i>iyi</dt>
                <dd><b><span data-count={bin.iyi.kb}>{bin.iyi.kb}</span> KB</b><span>starts in {bin.iyi.ms} ms</span></dd>
              </div>
              <div>
                <dt><i class="sw"></i>Crystal's lib</dt>
                <dd><b><span data-count={bin.crystal.kb}>{bin.crystal.kb.toLocaleString("en-GB")}</span> KB</b><span>starts in {bin.crystal.ms} ms</span></dd>
              </div>
            </dl>
          </div>
        </Stamped>
        <div class="stack-cards">
          <Stamped claim={`${front.seconds} s`} subject={front.subject} outcome="win">
            <p>
              The front end answers hello: parse, check, and refuse or accept,
              before any code is generated. It is why an editor and an agent
              can ask the compiler on every keystroke.
            </p>
          </Stamped>
          <Stamped claim={`${stringRow.gc_off.toFixed(2)}x slower`} subject={`where it loses · ${runtime.subject}`} outcome="loss">
            <p>
              at building strings, with the collector off. As it runs, the same
              workload is {stringRow.as_it_runs.toFixed(2)}x, within noise. The
              collector masks a slower builder. Cold builds of unseen code are
              slower; the speed is on the edit loop.
            </p>
          </Stamped>
        </div>
      </div>
      <p class="p young">
        Young parts, named: iyi's own prelude carries the small-tool floor and
        no more, so it has no TLS and no serialization, and sockets and format
        strings live in <code>std/socket</code> and <code>std/format</code>,{" "}
        outside the prelude every program carries; concurrency runs on Linux,
        macOS arm64 and Windows x86-64, and wasm32 gets no runtime at all
        rather than a sequential imitation of one; dependencies resolve and
        pin, but there is no registry and no artifact distribution yet, and{" "}
        <code>--crystal</code> still leans on shards.
      </p>
    </section>

    <section class="sec cta-band">
      <h2 class="h2">Check it yourself.</h2>
      <p class="p">
        Every number above is one of two things: counted from the tree, where
        it is the same on your machine as on ours, or recorded, in which case
        it carries the command that prints it and, where the number is a
        duration, the machine it ran on.
      </p>
      <div class="btns">
        <a class="button" href={`${base}playground/`}>Open the tour</a>
        <a class="button button--ghost" href={`${base}learn/`}>Start the lessons</a>
      </div>
    </section>
  </div>

  <style>
    .why-hero {
      max-width: 860px;
    }

    .sides {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      margin-top: clamp(32px, 5vw, 48px);
      background: var(--hairline);
      border: var(--hair) solid var(--hairline);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .sides a {
      background: var(--card);
      padding: 20px 22px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      color: var(--ink);
      text-decoration: none;
    }

    .sides a:hover {
      background: var(--raise);
      color: var(--ink);
    }

    .sides-n {
      font-size: 13px;
      font-weight: 600;
      color: var(--brand-deep);
    }

    .sides b {
      font-weight: 750;
      font-stretch: 108%;
      font-size: clamp(32px, 3.6vw, 44px);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .sides a > span:last-child {
      font-size: 14px;
      color: var(--graphite);
    }

    @media (max-width: 899px) {
      .sides {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .compat {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      align-self: center;
    }

    .compat li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 16px;
      border-radius: 12px;
      border: var(--hair) solid var(--hairline);
      background: var(--card);
    }

    .compat code {
      font-size: 15px;
      background: none;
      border: 0;
      padding: 0;
    }

    .moves {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: var(--hair) solid var(--hairline);
    }

    .moves li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 20px minmax(0, 1fr) minmax(0, 1.5fr) 56px;
      gap: 8px 16px;
      align-items: baseline;
      padding: 16px 4px;
      border-bottom: var(--hair) solid var(--hairline);
    }

    .moves code {
      background: none;
      border: 0;
      padding: 0;
      font-size: 13.5px;
      white-space: normal;
    }

    .moves-from,
    .moves-arrow {
      color: var(--mute);
    }

    .moves-to {
      color: var(--ink);
    }

    .moves-why {
      font-size: 14.5px;
      line-height: 1.5;
      color: var(--graphite);
    }

    .moves .chip {
      justify-self: start;
    }

    @media (max-width: 899px) {
      .moves li {
        grid-template-columns: auto minmax(0, 1fr) auto;
      }
      .moves-from {
        grid-column: 1 / -1;
      }
      .moves-arrow,
      .moves-to {
        grid-row: 2;
      }
      .moves .chip {
        grid-row: 2;
        grid-column: 3;
      }
      .moves-why {
        grid-column: 1 / -1;
      }
    }

    .trio {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .trio > div {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-top: 16px;
      border-top: var(--hair) solid var(--hairline);
    }

    .trio strong {
      font-weight: 650;
    }

    .trio .p {
      font-size: 15px;
    }

    @media (max-width: 799px) {
      .trio {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .targets {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      border: var(--hair) solid var(--hairline);
      border-radius: 14px;
      background: var(--card);
      overflow: hidden;
    }

    .targets li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 11px 16px;
      border-bottom: var(--hair) solid var(--hairline);
      font-family: var(--font-mono);
      font-size: 13px;
    }

    .targets li:last-child {
      border-bottom: 0;
    }

    .targets code {
      background: none;
      border: 0;
      padding: 0;
      font-size: inherit;
    }

    .targets li span {
      font-size: 12px;
      white-space: nowrap;
    }

    /* True area: iyi's square sits in the corner of Crystal's, so the eye
     * compares the two as areas rather than as lengths. */
    .area {
      position: relative;
      display: flex;
      align-items: center;
      gap: 28px;
      flex-wrap: wrap;
      padding: 24px 22px;
    }

    .area-plot {
      position: relative;
      flex: none;
    }

    /* Both squares grow out of the same corner, so they are compared as the
     * areas they are. The finished sizes are in the HTML; the script only
     * replays them. */
    .area-crystal {
      position: absolute;
      left: 0;
      bottom: 0;
      border-radius: 6px;
      background: repeating-linear-gradient(135deg, var(--raise) 0 6px, transparent 6px 12px);
      border: var(--hair) solid var(--boundary);
    }

    /* While the squares are drawing, the claim under them waits; it fades in
     * once iyi's square has landed. Visible by default, so with scripts off
     * the claim is simply there. */
    :global([data-area-state]) :global(.stat) {
      transition: opacity 0.4s ease;
    }

    :global([data-area-state="running"]) :global(.stat) {
      opacity: 0;
      transition: none;
    }

    .area-iyi {
      position: absolute;
      left: 0;
      bottom: 0;
      border-radius: 4px 4px 4px 6px;
      background: var(--ok);
      box-shadow: 0 0 0 3px var(--card);
    }

    .area-legend {
      margin: 0;
      flex: 1 1 160px;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .area-legend > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2px 12px;
      padding: 12px 0;
      border-bottom: var(--hair) solid var(--hairline);
    }

    .area-legend > div:last-child {
      border-bottom: 0;
    }

    .area-legend dt {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
      font-size: 15px;
      min-width: 0;
    }

    .area-legend dd {
      display: contents;
    }

    .area-legend dd b {
      font: 500 15px var(--font-mono);
      white-space: nowrap;
    }

    .area-legend dd span {
      grid-column: 1 / -1;
      padding-left: 22px;
      font-size: 13px;
      color: var(--graphite);
    }

    .sw {
      flex: none;
      width: 12px;
      height: 12px;
      border-radius: 3px;
      border: var(--hair) solid var(--boundary);
      background: repeating-linear-gradient(135deg, var(--raise) 0 3px, transparent 3px 6px);
    }

    .sw--iyi {
      border: 0;
      background: var(--ok);
    }

    .stack-cards {
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-width: 0;
    }

    .young {
      max-width: 760px;
      font-size: 15px;
    }

    .cta-band {
      align-items: center;
      text-align: center;
    }

    .cta-band .p {
      max-width: 560px;
    }

    .cta-band .btns {
      justify-content: center;
    }
  </style>

  <script>
    import { playWhenSeen, reducedMotion } from "../lib/play-when-seen";

    /* Puts "hello" at true area, played once when scrolled to and again on
     * Replay: Crystal's library first, then iyi's, then the ratio. Each
     * square's side follows the square root of the elapsed fraction, so its
     * area and the counter beside it grow in step. Short on purpose: a page
     * about speed does not keep its reader waiting. */
    const CRYSTAL_MS = 1000;
    const IYI_MS = 450;
    const PAUSE_MS = 150;

    document.querySelectorAll<HTMLElement>("[data-area]").forEach((area) => {
      if (reducedMotion()) return;
      const figure = area.closest("figure") ?? area;
      const crystal = area.querySelector<HTMLElement>(".area-crystal");
      const iyi = area.querySelector<HTMLElement>(".area-iyi");
      const [iyiCount, crystalCount] = [...area.querySelectorAll<HTMLElement>("[data-count]")];
      if (!crystal || !iyi || !iyiCount || !crystalCount) return;

      const grow = (square: HTMLElement, count: HTMLElement, p: number) => {
        const side = Number(square.dataset.side) * Math.sqrt(p);
        square.style.width = square.style.height = `${side}px`;
        square.style.visibility = p > 0 ? "visible" : "hidden";
        count.textContent = Math.round(Number(count.dataset.count) * p).toLocaleString("en-GB");
      };

      let raf = 0;
      const reset = () => {
        cancelAnimationFrame(raf);
        grow(crystal, crystalCount, 0);
        grow(iyi, iyiCount, 0);
        figure.setAttribute("data-area-state", "running");
      };

      const play = () => {
        reset();
        const t0 = performance.now();
        const frame = (now: number) => {
          const t = now - t0;
          grow(crystal, crystalCount, Math.min(1, t / CRYSTAL_MS));
          grow(iyi, iyiCount, Math.max(0, Math.min(1, (t - CRYSTAL_MS - PAUSE_MS) / IYI_MS)));
          if (t < CRYSTAL_MS + PAUSE_MS + IYI_MS) raf = requestAnimationFrame(frame);
          else figure.setAttribute("data-area-state", "done");
        };
        raf = requestAnimationFrame(frame);
      };

      /* The finished figure is what the HTML draws, for a reader with no
       * script. With one, it waits empty and plays when the whole of it is
       * in the upper two thirds of the screen. */
      reset();

      figure.setAttribute("data-chart", "ready");
      figure.querySelector("[data-replay]")?.addEventListener("click", play);
      playWhenSeen(area, play);
    });
  </script>
</Page>
