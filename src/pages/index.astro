---
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import Measure from "../components/Measure.astro";
import AgentRace from "../components/AgentRace.astro";
import RebuildRace from "../components/RebuildRace.astro";
import Sample from "../components/Sample.astro";
import Quote from "../components/Quote.astro";
import Platform from "../components/Platform.astro";
import facts from "../generated/facts.json";
import { tourSamples, runnable, playgroundHref } from "../playground/samples";
import { latestRelease, releaseAssets, windowsAsset } from "../lib/release";
import platforms from "../generated/targets.json";
import { SPELLED } from "../lib/lessons";
import mascot from "../assets/mascot.png";

const release = latestRelease();

/* The tour's first program, what it printed, and the route to it, all taken
 * from the tour's own table of contents. The page says "the first program of
 * the tour", so it follows the tour rather than naming a sample: the id and
 * the path were typed here, and either could have gone on pointing at a
 * program the tour had moved off the front. */
const [first] = tourSamples;
if (first === undefined || !runnable(first)) {
  throw new Error(
    "index: the tour's first step has no recorded module, so the home page " +
      "has no output to show beside it. Regenerate with npm run record:wasm.",
  );
}
const firstHref = playgroundHref(first.path);
if (firstHref === null) {
  throw new Error(`index: ${first.path} has no playground page to link to`);
}

const base = import.meta.env.BASE_URL;
const loop = facts.recorded.edit_loop;
const bin = facts.recorded.hello_binary;
const pack = facts.recorded.context_pack;

const massRatio = Math.round(bin.crystal.kb / bin.iyi.kb);

/* The platforms README.md says are run every build, out of
 * scripts/targets.mjs rather than counted into this sentence by hand. */
const ranCount = SPELLED[platforms.ran.length];

/* The wasm target, found in that run set rather than spelled into the
 * sentence below: the playground is the one claim on this page that depends on
 * a specific triple, and a rename of it (wasm32-wasip1 is where this is going)
 * would otherwise leave the home page naming a target nothing builds. */
const wasm = platforms.ran.find((t) => t.startsWith("wasm"));
if (wasm === undefined) {
  throw new Error(
    "index: no wasm target is in the run set, so the home page cannot say " +
      "the playground runs one. scripts/targets.mjs read the workflow and " +
      "README.md; one of the two dropped it.",
  );
}


/* The machines a release ships an archive for, in README.md's own words for
 * them, through scripts/install-targets.mjs. "Linux x86-64 or macOS arm64" was
 * typed into the install card, which made this page the third place that pair
 * was written down and the only one nothing checked. The Windows zip is read
 * out of the installer that fetches it, which is a different script and a
 * different archive, so it is named beside them rather than among them. */
const machines = releaseAssets(release).map((asset) => asset.machine);
const windows = windowsAsset(release);

---

<Page
  title="iyi, a friendly, fast language for people and their agents"
  summary="iyi is a compiled language written for two readers: the person editing the code and the agent editing it beside them. Modules compile against declarations, never bodies, so a build reads less and so does a model, and a grounded edit spent fewer prompt tokens over twenty-six measured runs."
>
  <div class="wrap">
    <div class="hero-row">
    <section class="page-hero">
      <h1 class="h1">A friendly, fast language for people and their agents.</h1>
      <p class="lead">
        iyi is a compiled language written for two readers: the person editing
        the code and the agent editing it beside them. One rule serves both. A
        module builds against its dependencies' declarations, never their
        bodies, so:
      </p>
      {/* The three consequences of the rule, as the sentence above lists
          them, set so they read at a glance. */}
      <ul class="follows">
        <li>a build reads less</li>
        <li>a program carries less</li>
        <li>a model reads an interface instead of a repository</li>
      </ul>
      <div class="btns">
        <a class="button" href={`${base}install/`}>Install {release.version}</a>
        <a class="button button--ghost" href={firstHref}>Try it in the browser</a>
      </div>

    </section>
    {/* The mascot, large, beside the one line. The largest thing painted above
        the fold, so it is eager and asks for priority. */}
    <div class="hero-art">
      <Image
        src={mascot}
        alt="The iyi mascot: a smiling red heart with yellow gloves, waving"
        width={280}
        height={264}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    </div>
    <div class="rebuild-wrap">
      <RebuildRace />
      <p class="small">
        Module names and the edit are illustrative. The two durations are the
        measured ones, from the same compiler binary under each set of rules,
        by a generator that refuses to start the clock until both print the
        same total.
      </p>
    </div>

    <section class="sec">
      <div class="sec__head">
        <h2 class="h2">What iyi is for</h2>
        <p class="p">Four things, and they are one design decision seen from four sides.</p>
      </div>
      <div class="grid4">
        <a class="pillar" href={`${base}why/#dx`}>
          <span class="big">{loop.claim.value}x</span>
          <strong class="h3">Quick to rebuild</strong>
          <span class="p">
            Change one line in one module and build again. iyi reads the
            declarations of everything else and none of the bodies.
          </span>
          <span class="link red">Why it is fast →</span>
        </a>
        <a class="pillar" href={`${base}agents/`}>
          <span class="big">{pack.tokens_low}–{pack.tokens_high}%</span>
          <strong class="h3">Made for agents</strong>
          <span class="p">
            Fewer prompt tokens for the same edit, because a module's interface
            is a file and not a convention.
          </span>
          <span class="link red">The loop, recorded →</span>
        </a>
        <a class="pillar" href={`${base}why/#portability`}>
          <span class="big"><Measure of="targets" /></span>
          <strong class="h3">Portable</strong>
          <span class="p">
            An iyi program compiles for <Measure of="targets" /> targets, and
            is run on {ranCount} of them on every build, including {wasm}.
          </span>
          <span class="link red">How the playground runs →</span>
        </a>
        <a class="pillar" href={`${base}why/#performance`}>
          <span class="big">{massRatio}x</span>
          <strong class="h3">Small and quick to start</strong>
          <span class="p">
            Native code through LLVM, and a program links only what it uses. A
            hello world is {massRatio}x smaller than with Crystal's library.
          </span>
          <span class="link red">The numbers →</span>
        </a>
      </div>
    </section>

    <section class="sec split">
      <div class="sec__head">
        <h2 class="h2">Try iyi</h2>
        <p class="p">
          It reads like Crystal or Ruby, and builds like a systems language.
          This is the first program of the tour, and the output beside it is
          what the compiler's build of it printed.
        </p>
        <a class="link" href={firstHref}>Run it in the playground →</a>
      </div>
      <div>
        <Sample path={first.path} />
        <div class="console">
          <div class="console-chrome">
            <span class="caption">output</span>
            <a class="copy run-here" href={firstHref}>Run it in the browser ▸</a>
          </div>
          <pre><span class="out">{first.nativeStdout}</span></pre>
        </div>
      </div>
    </section>

    {/* The agent argument, before the Crystal one, because it is the reason
        this language exists rather than a feature it grew. */}
    <section class="sec" id="agents">
      <div class="split">
        <div class="sec__head">
          <p class="eyebrow">Agent experience (AX)</p>
          <h2 class="h2">A model reads the interface, not the repository.</h2>
          <p class="p">
            A module compiles against its dependencies' declarations, never their
            bodies. That one rule is why a module's interface is a file, and why{" "}
            <code>iyi mod context</code> can hand an agent the exact surface of
            every import with no body in it and no repository behind it.
          </p>
          <a class="link" href={`${base}agents/`}>The loop, recorded →</a>
        </div>
        <ul class="list checks">
          <li>
            <strong>Grounding is one command.</strong>
            <span class="p"><code>iyi mod context --json</code> prints the surface an edit is allowed to know.</span>
          </li>
          <li>
            <strong>The verdict is data.</strong>
            <span class="p">
              <code>iyi check -f json</code> answers with the file, the line,
              the span and the exact replacement when the compiler knows the
              fix, and <code>iyi fix</code> applies it.
            </span>
          </li>
          <li>
            <strong>The servers are in the binary.</strong>
            <span class="p"><code>iyi lsp</code> for an editor and <code>iyi mcp</code> for a harness, both over stdio.</span>
          </li>
        </ul>
      </div>
      <div class="race-wrap">
        <AgentRace loop={`${base}agents/#loop`} hint="The recorded session →" />
        <p class="small">
          A replay of the measured result; the code in the lanes is
          illustrative. Rounds to green were the model's, tied{" "}
          {pack.rounds_tied} times and lost {pack.rounds_lost}.{" "}
          <a href={`${base}agents/`}>How it was measured</a>.
        </p>
      </div>
    </section>

    <section class="sec split" id="crystal">
      <div class="sec__head">
        <p class="eyebrow">Coming from Crystal?</p>
        <h2 class="h2">iyi runs your Crystal code today.</h2>
        <p class="p">
          iyi's compiler is Crystal's compiler. Your <code>.cr</code> files
          build unchanged, and <code>iyi build --crystal</code> gives an iyi
          program Crystal's standard library, <code>require</code>, and the
          shards you already depend on. Blocks, union types, nil-safety and
          macros are all here.
        </p>
        <p class="p">
          The listing is a Kemal server written as an iyi module, and the
          console under it is that server answering. What iyi adds is one
          rule about where things may be written, and the compiler teaches it
          as you go.
        </p>
      </div>
      <div>
        <Quote id="kemal_site" as="source" caption="site.iyi" />
        <Quote id="kemal_run" as="console" caption="console" />
      </div>
    </section>

    <section class="sec split">
      <div class="sec__head">
        <h2 class="h2">Install in one line</h2>
        <p class="p">
          The latest release into <code>~/.local</code> on{" "}
          {machines.join(" or ")}, or into <code>%LOCALAPPDATA%</code> on{" "}
          {windows.machine}, with both libraries and the samples. Then hello.
        </p>
        <a class="link" href={`${base}install/`}>What the installer does, and the by-hand version →</a>
      </div>
      <div class="install-run">
      <Platform
        id="home-install"
        label="The machine you are installing on"
        posix={machines.join(" / ")}
        windows={windows.machine}
      >
        <Quote slot="posix" id="install" as="shell" caption="sh" copy />
        <Quote slot="windows" id="install_windows" as="shell" caption="PowerShell" copy />
      </Platform>
      </div>
    </section>


  </div>

  <style>
    .eyebrow a {
      color: inherit;
      text-decoration: none;
    }

    .hero-row :global(.page-hero) {
      padding-top: clamp(32px, 4vw, 48px);
    }

    .hero-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(24px, 4vw, 56px);
    }

    /* Centred on the copy, not on the section's padding above it. */
    .hero-art {
      padding-top: clamp(32px, 4vw, 48px);
    }

    .hero-art :global(img) {
      display: block;
      width: clamp(200px, 22vw, 280px);
      height: auto;
    }

    /* On a phone the line is the hero; the mascot is already in the
     * masthead. */
    @media (max-width: 760px) {
      .hero-row {
        grid-template-columns: minmax(0, 1fr);
      }
      .hero-art {
        display: none;
      }
    }

    .follows {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 4px 18px;
      font-size: clamp(16px, 1.5vw, 18px);
      line-height: 1.5;
      color: var(--ink);
    }

    .follows li {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .follows li::before {
      content: "";
      flex: none;
      width: 6px;
      height: 6px;
      transform: translateY(-2px);
      border-radius: 50%;
      background: var(--brand);
    }

    .run-here {
      text-decoration: none;
    }

    .rebuild-wrap {
      margin-top: clamp(20px, 3vw, 36px);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .race-wrap {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .pillar {
      color: var(--ink);
      text-decoration: none;
    }

    .pillar:hover {
      color: var(--ink);
      background: var(--raise);
    }

    .pillar .p {
      font-size: 14.5px;
    }

    .pillar .big :global(.measure-value) {
      font: inherit;
      color: inherit;
    }

    /* The install commands are one line each and are read as lines. */
    .install-run :global(.console pre) {
      white-space: pre;
      overflow-x: auto;
    }

    .pillar .link {
      margin-top: auto;
      padding-top: 8px;
    }
  </style>
</Page>
