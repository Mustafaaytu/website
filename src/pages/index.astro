---
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import Measure from "../components/Measure.astro";
import Stamped from "../components/Stamped.astro";
import DurationChart from "../components/DurationChart.astro";
import Sample from "../components/Sample.astro";
import Quote from "../components/Quote.astro";
import Platform from "../components/Platform.astro";
import facts from "../generated/facts.json";
import { tourSamples, runnable, playgroundHref } from "../playground/samples";
import { latestRelease, releaseUrl, releaseAssets, windowsAsset } from "../lib/release";
import platforms from "../generated/targets.json";
import { SPELLED, sequence } from "../lib/lessons";
import mascot from "../assets/mascot.png";
import readme from "../generated/readme.json";

const release = latestRelease();

/* The tour's first program, what it printed, and the route to it, all taken
 * from the tour's own table of contents. The page says "the first program of
 * the tour", so it follows the tour rather than naming a sample: the id and
 * the path were typed here, and either could have gone on pointing at a
 * program the tour had moved off the front. */
const [first] = tourSamples;
if (first === undefined || !runnable(first)) {
  throw new Error(
    "index: the tour's first step has no recorded module, so the home page " +
      "has no output to show beside it. Regenerate with npm run record:wasm.",
  );
}
const firstHref = playgroundHref(first.path);
if (firstHref === null) {
  throw new Error(`index: ${first.path} has no playground page to link to`);
}

const base = import.meta.env.BASE_URL;
const loop = facts.recorded.edit_loop;
const bin = facts.recorded.hello_binary;
const pack = facts.recorded.context_pack;

const ratios = loop.ratios as number[];
const loopClaim = `About ${loop.claim.value}x less than Crystal, on the line you just changed.`;
const loopBand = `${Math.min(...ratios).toFixed(2)}x to ${Math.max(...ratios).toFixed(2)}x across ${loop.sessions.length} published sessions.`;
const massRatio = Math.round(bin.crystal.kb / bin.iyi.kb);

/* The first screen's code: README.md's first module, the file that imports
 * it, and the session that builds the program, deletes the library and builds
 * it again. That is the repository's own demonstration of the rule the
 * headline states, so it is quoted rather than restated, and it is the first
 * thing a reader sees beside the headline on a desk and under it on a phone.
 * Each listing's caption is its file, named by its own `module` line, because
 * a module's path is its file's path: the README says so in prose, and typing
 * the two names here would be a second copy of a fact the listing carries. */
const fileOf = (id: "first_module" | "first_import"): string => {
  const named = /^module (\S+)$/m.exec(readme[id].text);
  if (named === null) {
    throw new Error(
      `index: README.md's block "${id}" (${readme[id].cite}) declares no ` +
        `module, so the home page cannot say which file it is. The listing ` +
        `changed; re-anchor it in scripts/samples.mjs.`,
    );
  }
  return `${named[1]}.iyi`;
};

/* The platforms README.md says are run every build, out of
 * scripts/targets.mjs rather than counted into this sentence by hand. */
const ranCount = SPELLED[platforms.ran.length];

/* The wasm target, found in that run set rather than spelled into the
 * sentence below: the playground is the one claim on this page that depends on
 * a specific triple, and a rename of it (wasm32-wasip1 is where this is going)
 * would otherwise leave the home page naming a target nothing builds. */
const wasm = platforms.ran.find((t) => t.startsWith("wasm"));
if (wasm === undefined) {
  throw new Error(
    "index: no wasm target is in the run set, so the home page cannot say " +
      "the playground runs one. scripts/targets.mjs read the workflow and " +
      "README.md; one of the two dropped it.",
  );
}

/* The lessons, counted rather than stated: this card said "Five lessons" while
 * the count lives in src/content/learn, so adding a lesson made the home page
 * wrong and no gate could see it. Spelled through the same table and with the
 * same fallback the learn index uses, which is what a thirteenth lesson would
 * need. */
const lessons = await sequence();
const spelled = SPELLED[lessons.length] ?? String(lessons.length);
const lessonCount = `${spelled[0].toUpperCase()}${spelled.slice(1)}`;

/* The machines a release ships an archive for, in README.md's own words for
 * them, through scripts/install-targets.mjs. "Linux x86-64 or macOS arm64" was
 * typed into the install card, which made this page the third place that pair
 * was written down and the only one nothing checked. The Windows zip is read
 * out of the installer that fetches it, which is a different script and a
 * different archive, so it is named beside them rather than among them. */
const machines = releaseAssets(release).map((asset) => asset.machine);
const windows = windowsAsset(release);

const starts = [
  {
    title: "Take the tour",
    body: "The language in short programs, from hello to traits, generics and tasks. Each one runs in your browser; nothing needs installing.",
    href: "playground/",
    cta: "Start the tour",
  },
  {
    title: "Learn the rule",
    body: `${lessonCount} lessons on what makes iyi its own language, each one a real program from the repository, and each one ending in a mistake so you meet the compiler's own error on purpose.`,
    href: "learn/",
    cta: "Start the lessons",
  },
  {
    title: "Install it",
    body: `One command installs the latest release, on ${machines.join(" and ")} and now ${windows.machine} too, with both libraries and the samples. The second command runs hello.`,
    href: "install/",
    cta: "Install iyi",
  },
];
---

<Page
  title="iyi, a language whose modules compile against declarations, never bodies"
  summary={`iyi is a compiled language whose modules compile against their dependencies' declarations, never their bodies. So a changed line rebuilds ${loop.claim.value}x faster than under Crystal's rules, and an agent grounds an edit in an interface instead of a repository.`}
>
  {/* The hero is four grid children rather than a copy column and an art
      column, so a phone can put the code straight under the headline and
      the paragraph after it, and a desk can stand the code beside all three.
      The mascot is small on purpose: it was half the first screen, and the
      first screen is where a reader decides whether this is a language worth
      reading, which a drawing cannot tell them and a listing can. */}
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-art">
        <Image
          src={mascot}
          alt="The iyi mascot: a smiling red heart with yellow gloves, waving"
          width={128}
          height={120}
          densities={[1, 2]}
          loading="eager"
          decoding="async"
        />
      </div>
      <h1>Modules compile against declarations, never bodies.</h1>
      <div class="hero-code">
        <p class="label">Build it, delete the library's source, build it again</p>
        <Quote id="first_module" as="source" caption={fileOf("first_module")} />
        <Quote id="first_import" as="source" caption={fileOf("first_import")} />
        <Quote id="the_rule" as="console" />
      </div>
      <div class="hero-copy">
        <p class="lede">
          iyi is a compiled language built on that rule. A changed line
          rebuilds {loop.claim.value}x faster than under Crystal's rules, and
          an agent grounds an edit in an interface instead of a repository.
        </p>
        <div class="hero-cta">
          <a class="cta" href={`${base}playground/`}>Take the tour</a>
          <a class="cta ghost" href={`${base}install/`}>Install</a>
        </div>
        <p class="release">
          <a href={releaseUrl(release)}>Version {release.version}</a>, {release.date}
        </p>
      </div>
    </div>
  </section>

  <section class="try">
    <div class="wrap try-inner">
      <div class="try-copy">
        <h2>Try iyi</h2>
        <p>
          It reads like Crystal or Ruby, and builds like a systems language.
          This is the first program of the tour, and the output beside it is
          what the compiler's build of it printed.
        </p>
        <p>
          <a href={firstHref}>Run it in the tour</a>
        </p>
      </div>
      <div class="try-run">
        <Sample path={first.path} />
        <div class="console">
          <div class="console-chrome" aria-hidden="true">
            <i></i><i></i><i></i>
            <span class="caption">iyi run {first.path}</span>
          </div>
          <pre><span class="out">{first.nativeStdout}</span></pre>
        </div>
      </div>
    </div>
  </section>

  {/* The agent argument, before the Crystal one, because it is the reason
      this language exists rather than a feature it grew. It is one rule seen
      from the other side: a build that reads declarations instead of bodies is
      a model that reads declarations instead of bodies, and the card is what
      that cost when it was measured. */}
  <section class="agents" id="agents">
    <div class="wrap agents-inner">
      <div class="agents-copy">
        <p class="label">Written for agents</p>
        <h2>A model reads the interface, not the repository.</h2>
        <p class="agents-lede">
          A module compiles against its dependencies' declarations, never their
          bodies. That one rule is why a module's interface is a file, and why{" "}
          <code>iyi mod context</code> can hand an agent the exact surface of
          every import with no body in it and no repository behind it. The
          context window is the new compile time, and this is a language that
          spends it like one.
        </p>
        <ul class="checks">
          <li>
            <strong>Grounding is one command.</strong>{" "}
            <code>iyi mod context --json</code> prints the surface an edit is
            allowed to know.
          </li>
          <li>
            <strong>The verdict is data.</strong> <code>iyi check -f json</code>{" "}
            answers with the file, the line, the span and the exact replacement
            when the compiler knows the fix, and <code>iyi fix</code> applies
            it.
          </li>
          <li>
            <strong>The servers are in the binary.</strong>{" "}
            <code>iyi lsp</code> for an editor and <code>iyi mcp</code> for a
            harness, both over stdio, both shells around the same front end a
            build uses.
          </li>
        </ul>
        <div class="hero-cta">
          <a class="cta" href={`${base}agents/`}>See the recorded loop</a>
        </div>
      </div>
      <Stamped
        claim={`${pack.tokens_low} to ${pack.tokens_high}% fewer prompt tokens.`}
        band={`The grounding pack is ${pack.size_low} to ${pack.size_high}% of the size of the sources it replaces, over ${pack.runs} measured runs.`}
        subject={pack.subject}
        outcome="win"
      >
        <p class="stamp-note">
          Rounds to green were the model's, and they were tied{" "}
          {pack.rounds_tied} times and lost {pack.rounds_lost} times. Both
          readings come off one gate and both are published.{" "}
          <a href={`${base}agents/benchmark/`}>How this is measured</a>
        </p>
      </Stamped>
    </div>
  </section>

  <section class="crystal" id="crystal">
    <div class="wrap crystal-inner">
      <div class="crystal-copy">
        <p class="label">Coming from Crystal?</p>
        <h2>iyi runs your Crystal code today.</h2>
        <p class="crystal-lede">
          iyi's compiler is Crystal's compiler. Your <code>.cr</code> files
          build unchanged, and <code>iyi build --crystal</code> gives an iyi
          program Crystal's standard library, <code>require</code>, and the
          shards you already depend on. Nothing to port first, and nothing to
          give up: blocks, union types, nil-safety and macros are all here.
        </p>
        <p class="crystal-lede">
          The listing here is a Kemal server written as an iyi module, and the
          console under it is that server answering. What iyi adds is one rule
          about where things may be written, and the compiler teaches it as you
          go.
        </p>
        <div class="hero-cta">
          <a class="cta" href={`${base}learn/`}>Learn the one rule</a>
          <a class="cta ghost" href={`${base}why/#moved`}>What moved, and why</a>
        </div>
      </div>
      <div class="crystal-run">
        <Quote id="kemal_site" as="source" caption="site.iyi" />
        <Quote id="kemal_run" as="console" caption="a Kemal server, from an iyi program" />
      </div>
    </div>
  </section>

  <section class="install">
    <div class="wrap install-inner">
      <div>
        <h2>Install in one line</h2>
        <p class="section-sub">
          The latest release into <code>~/.local</code> on{" "}
          {machines.join(" or ")}, or into <code>%LOCALAPPDATA%</code> on{" "}
          {windows.machine}, with both libraries and the samples. Then hello.
        </p>
        <p><a href={`${base}install/`}>What the installer does, and the by-hand version</a></p>
      </div>
      <Platform
        id="home-install"
        label="The machine you are installing on"
        posix={machines.join(" / ")}
        windows={windows.machine}
      >
        <Quote slot="posix" id="install" as="shell" caption="install, then run hello" copy />
        <Quote
          slot="windows"
          id="install_windows"
          as="shell"
          caption="install on Windows, then run hello"
          copy
        />
      </Platform>
    </div>
  </section>

  <section class="features">
    <div class="wrap">
      <h2>What iyi is for</h2>
      <p class="section-sub">
        Four things, and they are one design decision seen from four sides.
      </p>
      <ul class="cards">
        <li class="card">
          <p class="card-figure">{loop.claim.value}x</p>
          <h3>Quick to rebuild</h3>
          <p>
            Change one line in one module and build again. iyi reads the
            declarations of everything else and none of the bodies, so the edit
            loop is {loop.claim.value}x shorter than the same compiler
            without the rule.
          </p>
          <a href={`${base}why/`}>Why it is fast</a>
        </li>
        <li class="card">
          <p class="card-figure">{pack.tokens_low} to {pack.tokens_high}%</p>
          <h3>Made for agents</h3>
          <p>
            Fewer prompt tokens for the same edit, because a module's interface
            is a file and not a convention. One command grounds an edit in
            every import's exact surface, <code>iyi check</code> answers as
            data with suggested edits, and <code>iyi mcp</code> serves it all
            over the protocol agents speak.
          </p>
          <a href={`${base}agents/`}>The loop, recorded</a>
        </li>
        <li class="card">
          <p class="card-figure"><Measure of="targets" /></p>
          <h3>Portable</h3>
          <p>
            An iyi program compiles for <Measure of="targets" /> targets, and is
            run on {ranCount} of them on every build. One of those is {wasm},
            which is what the playground on this site uses.
          </p>
          <a href={`${base}playground/evidence/`}>How the playground runs</a>
        </li>
        <li class="card">
          <p class="card-figure">{massRatio}x</p>
          <h3>Small and quick to start</h3>
          <p>
            Native code through LLVM, and a program links only what it uses. A
            hello world is {massRatio}x smaller than the same program with
            Crystal's library.
          </p>
          <a href={`${base}why/`}>The numbers, with the machine they ran on</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="measured">
    <div class="wrap">
      <h2>Measured</h2>
      <p class="section-sub">
        One line changed in one of <Measure of="modules" /> modules,{" "}
        <Measure of="generated" /> lines
        in all, built by iyi and by the same compiler under Crystal's rules, by
        a generator that refuses to start the clock until both print the same
        total. The bars run at real speed.
      </p>
      <Stamped
        claim={loopClaim}
        band={loopBand}
        subject={loop.subject}
        outcome="win"
      >
        <DurationChart />
      </Stamped>
      <p class="section-sub">
        The rest of the numbers, binary size and start time among them, are on
        the <a href={`${base}why/`}>why page</a>, each one a reading off a
        machine rather than a property of the language.
      </p>
    </div>
  </section>

  <section class="starts">
    <div class="wrap">
      <h2>Get started</h2>
      <ul class="cards starts-cards">
        {
          starts.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <a href={s.href.startsWith("http") ? s.href : `${base}${s.href}`}>{s.cta}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <style>
    section {
      padding-block: clamp(2.5rem, 5vw, 4.5rem);
    }

    section h2 {
      font-size: var(--step-3);
      margin-block-end: 0.6rem;
    }

    .section-sub {
      color: var(--graphite);
      max-width: 62ch;
      margin-block-end: 1.6rem;
      font-size: var(--step-0);
    }

    /* Hero ------------------------------------------------------------- */

    .hero {
      padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
    }

    /* On a desk the mascot, the headline and the paragraph stack on the left
     * and the code stands beside all three, wide enough that the session's
     * longest line does not wrap at the full container. On a phone it is one
     * column in reading order with the code second, straight under the
     * headline, so the first screen of a phone holds a listing rather than a
     * drawing and a paragraph. */
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      grid-template-areas:
        "art  code"
        "head code"
        "copy code";
      grid-template-rows: auto auto 1fr;
      gap: 1.1rem clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    .hero-art {
      grid-area: art;
    }

    .hero h1 {
      grid-area: head;
      font-size: var(--step-4);
      font-weight: 800;
      letter-spacing: -0.03em;
      max-width: 18ch;
      margin: 0;
    }

    .hero-code {
      grid-area: code;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      min-width: 0;
    }

    .hero-code .label {
      margin: 0;
    }

    .hero-code :global(.source) {
      background: var(--raise);
    }

    .hero-copy {
      grid-area: copy;
    }

    @media (max-width: 52rem) {
      .hero-inner {
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas:
          "art"
          "head"
          "code"
          "copy";
        grid-template-rows: none;
      }
      .hero-inner .hero-art :global(img) {
        width: 4.5rem;
      }
    }

    .lede {
      font-size: var(--step-1);
      line-height: 1.5;
      color: var(--graphite);
      max-width: 44ch;
      margin: 0 0 1.6rem;
    }

    .hero-cta {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .release {
      margin: 1rem 0 0;
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--mute);
    }

    .release a {
      color: var(--graphite);
      font-weight: 600;
    }

    /* `:global(img)` because astro:assets renders the element, so this
     * file's scoping attribute is not on it. */
    .hero-art :global(img) {
      display: block;
      width: 8rem;
      height: auto;
    }

    /* Try -------------------------------------------------------------- */

    .try {
      background: var(--raise);
      border-block: var(--hair) solid var(--hairline);
    }

    .try-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    @media (max-width: 52rem) {
      .try-inner {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .try-copy p {
      color: var(--graphite);
      max-width: 40ch;
    }

    .try-run :global(.source) {
      background: var(--paper);
    }

    .try-run .console {
      margin-block-start: 0.9rem;
    }

    /* Agents ----------------------------------------------------------- */

    /* A band, so the page reads hero, a program, then the argument. The
     * measurement sits beside the copy rather than under it: the claim and
     * what it cost are one thing. */
    .agents {
      background: var(--raise);
      border-block: var(--hair) solid var(--hairline);
    }

    .agents-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    @media (max-width: 60rem) {
      .agents-inner {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .agents h2 {
      margin-block: 0.4rem 0.8rem;
      max-width: 30ch;
    }

    .agents-lede {
      color: var(--graphite);
      font-size: var(--step-0);
      max-width: 54ch;
      margin-block-end: 1.4rem;
    }

    .stamp-note {
      color: var(--graphite);
      font-size: var(--step--1);
      max-width: 52ch;
      margin-block: 0 0.8rem;
    }

    /* Crystal ---------------------------------------------------------- */

    .crystal {
      background: var(--brand-soft);
      border-block-end: var(--hair) solid var(--hairline);
    }

    .crystal-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    @media (max-width: 52rem) {
      .crystal-inner {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .crystal .label {
      color: var(--brand-deep);
    }

    .crystal h2 {
      margin-block: 0.4rem 0.8rem;
    }

    .crystal-lede {
      color: var(--graphite);
      font-size: var(--step-0);
      max-width: 52ch;
    }

    .checks {
      list-style: none;
      margin: 0 0 1.6rem;
      padding: 0;
      display: grid;
      gap: 0.7rem;
      max-width: 52ch;
    }

    .checks li {
      position: relative;
      padding-inline-start: 1.6rem;
      color: var(--graphite);
      font-size: var(--step--1);
    }

    .checks li::before {
      content: "";
      position: absolute;
      left: 0.1rem;
      top: 0.45em;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--brand);
    }

    .checks strong {
      color: var(--ink);
    }

    .crystal-run :global(.source) {
      background: var(--paper);
    }

    .crystal-run :global(.console) {
      margin-block-start: 0.9rem;
    }

    /* Install ---------------------------------------------------------- */

    .install {
      border-block-end: var(--hair) solid var(--hairline);
    }

    .install-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: center;
    }

    @media (max-width: 52rem) {
      .install-inner {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .install :global(.console pre) {
      white-space: pre;
      overflow-x: auto;
    }

    /* Cards ------------------------------------------------------------ */

    .cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    }

    .card {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 1.5rem;
      border: var(--hair) solid var(--hairline);
      border-radius: var(--radius-lg);
      background: var(--paper);
    }

    .card h3 {
      font-size: var(--step-1);
    }

    .card p {
      margin: 0;
      color: var(--graphite);
      font-size: var(--step--1);
      flex: 1;
    }

    .card > a {
      font-weight: 600;
      font-size: var(--step--1);
      margin-block-start: 0.4rem;
    }

    .card .card-figure {
      font-size: var(--step-4);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--brand);
      flex: 0 !important;
    }

    .card .card-figure.mono {
