---
/**
 * /agents: the loop an agent runs against iyi, as a recording.
 *
 * Three things on the page. A race at the top that replays the measured
 * result as an animation, and says under it that it is a replay. The loop
 * itself, four steps, every command and every byte it printed read out of
 * records/agent.json, which `npm run record:agent` wrote against a real
 * compiler. And the rebuild question, answered by the recorded `iyi mod diff`
 * of the same project.
 *
 * Nothing is typed here that the recording or facts.json holds. The person
 * reading of each frame is derived from the frame's own bytes below, so the
 * two readings of one frame cannot say different things.
 */
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import Measure from "../components/Measure.astro";
import facts from "../generated/facts.json";
import record from "../../records/agent.json";
import mascot from "../assets/mascot.png";

const base = import.meta.env.BASE_URL;
const pack = facts.recorded.context_pack;
const provenance = record.recorded;

type Frame = (typeof record.frames)[number];

const frame = (id: string): Frame & { answer: string } => {
  const found = record.frames.find((f) => f.id === id);
  if (!found) {
    throw new Error(
      `agents: records/agent.json has no frame "${id}". It has ` +
        `${record.frames.map((f) => f.id).join(", ")}. Re-record with ` +
        `"npm run record:agent" rather than dropping the frame from the page.`,
    );
  }
  if (found.payload !== "stdout" && found.payload !== "stderr") {
    throw new Error(`agents: frame "${id}" answers on "${found.payload}", which is not a stream`);
  }
  return { ...found, answer: found[found.payload as "stdout" | "stderr"] };
};

const projectFile = (name: string) => {
  const found = record.project.find((file) => file.name === name);
  if (!found) throw new Error(`agents: records/agent/${name} is not in the recording`);
  return found;
};

const consumer = projectFile("app.iyi");
const before = consumer.text.replace(/\n$/, "").split("\n");
const after = record.repaired.text.replace(/\n$/, "").split("\n");

const [edit] = record.suggested;
if (!edit) throw new Error("agents: the recording carries no suggested edit to show");

const importLine = before.findIndex((line) => line.startsWith("import ")) + 1;
if (importLine === 0) throw new Error("agents: app.iyi imports nothing, so there is no surface to ground");

/* The person's reading of each frame, derived from the frame. */
type Row = { key: string; text: string; tone?: "error" | "ok" };

const firstLine = (s: string) => s.split("\n")[0];

const groundRows = (answer: string): Row[] => {
  const pack = JSON.parse(answer) as {
    imports: Array<{
      import: string;
      api: {
        interface_hash: string;
        functions: Array<{ rendered: string }>;
        types: Array<{ name: string; kind: string; methods: Array<{ rendered: string }> }>;
      };
    }>;
  };
  return pack.imports.flatMap((entry) => [
    { key: "import", text: `${entry.import} · interface ${entry.api.interface_hash.slice(0, 8)}` },
    ...entry.api.functions.map((f) => ({ key: "def", text: f.rendered.replace(/^def /, "") })),
    ...entry.api.types.map((t) => ({
      key: t.kind,
      text: `${t.name} · ${t.methods.map((m) => m.rendered).join(" · ")}`,
    })),
  ]);
};

const checkRows = (answer: string): Row[] => {
  const verdict = JSON.parse(answer) as Array<{
    line: number;
    column: number;
    message: string;
    suggested_edit?: { line: number; column: number; size: number; replacement: string };
  }>;
  return verdict.flatMap((entry) => {
    const rows: Row[] = [
      {
        key: `${entry.line}:${entry.column}${entry.suggested_edit ? " error" : ""}`,
        text: firstLine(entry.message),
        tone: entry.suggested_edit ? "error" : undefined,
      },
    ];
    if (entry.suggested_edit) {
      const s = entry.suggested_edit;
      rows.push({
        key: "fix",
        text: `replace ${s.size} characters at ${s.line}:${s.column} with '${s.replacement}'`,
        tone: "ok",
      });
    }
    return rows;
  });
};

const plainRows = (key: string, answer: string, silent: string, tone?: "ok"): Row[] =>
  answer.trim() === "" ? [{ key, text: silent }] : [{ key, text: answer.trim(), tone }];

const run = (id: string, label: string, rows: (answer: string) => Row[]) => {
  const f = frame(id);
  return { command: f.command, label, stream: f.payload, exit: f.exitCode, raw: f.answer, rows: rows(f.answer) };
};

const steps = [
  {
    title: "Ground the edit",
    source: before,
    mark: { line: importLine, tone: "warn" },
    runs: [run("ground", "the grounding pack", groundRows)],
  },
  {
    title: "Ask for the verdict",
    source: before,
    mark: { line: edit.line, tone: "err" },
    runs: [run("check", "the compiler's verdict", checkRows)],
  },
  {
    title: "Apply it, and confirm",
    source: after,
    mark: { line: edit.line, tone: "ok" },
    runs: [
      run("fix", "the repair", (a) => plainRows("fixed", a, "", "ok")),
      run("clean", "green, and silent about it", (a) =>
        plainRows("exit 0", a, "No output. The verdict is the exit code."),
      ),
    ],
  },
  {
    title: "Re-run only what the change reaches",
    source: after,
    mark: null,
    runs: [
      run("affected-hit", "a module the test imports", (a) => plainRows("ran", a, "")),
      run("affected-miss", "a module nothing imports", (a) => plainRows("skipped", a, "")),
    ],
  },
];

/* The rebuild question. The consumers are the files in the recorded project
 * that import the module the edit is in, read out of their own text. */
const edited = projectFile("app/greeter.iyi");
const editedModule = /^module (\S+)/m.exec(edited.text)?.[1];
if (!editedModule) throw new Error("agents: app/greeter.iyi declares no module");
const consumers = record.project
  .filter((file) => file !== edited && new RegExp(`^import ${editedModule}\\b`, "m").test(file.text))
  .map((file) => /^module (\S+)/m.exec(file.text)?.[1] ?? file.name);

const verdictOf = (answer: string) => answer.trim().split("\n").at(-1) ?? "";
const diffs = [
  { key: "body", label: "Change a body", frame: frame("diff-body") },
  { key: "api", label: "Change a declaration", frame: frame("diff-api") },
].map((d) => {
  const moved = /interface\s+changed/.test(d.frame.answer);
  return { ...d, moved, verdict: verdictOf(d.frame.answer), output: d.frame.answer.replace(/\n+[^\n]*\n?$/, "") };
});
---

<Page
  title="iyi for agents"
  summary={`Your agent reads the interface, not the repository. The loop an agent runs against iyi, recorded: ground, check, fix, and re-run what the change reaches. ${pack.tokens_low} to ${pack.tokens_high}% fewer prompt tokens over ${pack.runs} measured runs.`}
>
  <div class="wrap">
    <section class="page-hero agents-hero">
      <div class="agents-copy">
        <p class="eyebrow">
          <Image src={mascot} alt="" width={20} height={19} densities={[1, 2]} loading="eager" decoding="async" />
          For agents, and for you
        </p>
        <h1 class="h1">Your agent reads the interface, not the repository.</h1>
        <p class="lead">
          When it's wrong, the compiler hands it the fix. iyi holds this by
          language rule: a module compiles against what its dependencies
          declare, so a model can work from declarations alone.
        </p>
      </div>

      {/* The settled state is what is built: both lanes finished, every step
          ticked, the result in the foot. The script takes it back to the start
          and replays it. */}
      <div
        class="race"
        id="race"
        data-modules={facts.structural.modules}
        data-pack-low={pack.size_low}
        data-pack-high={pack.size_high}
        data-done="true"
      >
        <div class="race-in">
          <div class="race-top">
            <span>
              <i class="race-dot" data-dot data-done="true"></i>
              <span class="race-title">same task, both arms</span>
              <span>fix one misspelled call</span>
            </span>
            <button type="button" class="race-replay" data-replay>
              <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M10 6a4 4 0 1 1-1.2-2.85M10 1.5v2.2H7.8" /></svg>
              Replay
            </button>
          </div>
          <div class="lanes">
            {
              [
                { k: 0, name: "Reading the sources", what: "every body the edit depends on", final: "100%", width: 100 },
                { k: 1, name: "With iyi", what: "iyi mod context: declarations only", final: `${pack.size_low}–${pack.size_high}%`, width: (pack.size_low + pack.size_high) / 2 },
              ].map((lane) => (
                <div class="lane" data-lane={lane.k} data-full={String(lane.k === 0)}>
                  <div class="lane-text" aria-hidden="true"></div>
                  <div class="lane-ui">
                    <div class="lane-head">
                      <b>{lane.name}</b>
                      <span>{lane.what}</span>
                    </div>
                    <div class="lane-foot">
                      <div class="lane-num">
                        <b>{lane.final}</b>
                        <span>of the sources' size</span>
                      </div>
                      <div class="lane-bar"><i style={`width:${lane.width}%`}></i></div>
                      <div class="lane-steps">
                        {["read", "check", "fix", "test"].map((label, i) => (
                          <button type="button" data-goto={i} data-state="done" title="See this step in the recorded session">
                            <span aria-hidden="true"></span>
                            {label}
                          </button>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="race-foot" data-foot data-done="true">
            <p class="when-done">
              <b>
                Same fix. <span class="ok">{pack.tokens_low}–{pack.tokens_high}% fewer prompt tokens,</span>{" "}
                for no fewer rounds.
              </b>
              <span class="race-hint">Tap a step to see the real recording ↓</span>
            </p>
            <p class="when-running">Same four verbs in both lanes. Watch what each one has to read.</p>
          </div>
        </div>
      </div>
      <p class="small">
        A replay of the measured result (method below). Code shown is
        illustrative; the recorded session follows.
      </p>
    </section>

    <section class="sec" id="loop">
      <div class="sec__head">
        <span class="badge" title={`${provenance.command} refuses to publish a frame whose verdict moved`}>
          <i></i>recorded with {provenance.compiler.split(" (")[0]} · {provenance.commit.slice(0, 9)}
        </span>
        <h2 class="h2">The loop, recorded.</h2>
        <p class="p">
          {record.project.length} files, one mistake, the compiler's own verbs.
          The same verbs answer over MCP, byte for byte.
        </p>
      </div>

      <div class="loop" id="loopbox" data-reader="person">
        <div class="loop-tabs" role="tablist" aria-label="Steps">
          {
            steps.map((step, i) => (
              <button type="button" role="tab" data-step={i} aria-selected={i === 0 ? "true" : "false"}>
                <span class="n">0{i + 1}</span>
                <span class="t">{step.title}</span>
                <span class:list={["chip", step.runs[0].exit ? "chip--red" : "chip--ok"]}>exit {step.runs[0].exit}</span>
              </button>
            ))
          }
        </div>

        {
          steps.map((step, i) => (
            <div class="loop-step" data-step-panel={i}>
              <h3 class="loop-step-title">
                0{i + 1} · {step.title}
              </h3>
              <div class="loop-file">records/agent/{consumer.name} · {step.source.length} lines</div>
              <div class="src">
                {step.source.map((line, n) => (
                  <div class:list={[step.mark && step.mark.line === n + 1 && `m-${step.mark.tone}`]}>
                    <span>{n + 1}</span>
                    <span class:list={[{ com: line.startsWith("#") }]}>{line || " "}</span>
                  </div>
                ))}
              </div>
              {step.runs.map((r) => (
                <div class="run">
                  <div class="run-head">
                    <span>
                      <span class="faint">$ </span>
                      {r.command}
                    </span>
                    <span>
                      <span>{r.label}</span>
                      <span>{r.stream}</span>
                      <span class:list={[r.exit ? "red" : "ok"]}>exit {r.exit}</span>
                    </span>
                  </div>
                  <div class="run-human">
                    {r.rows.map((row) => (
                      <div>
                        <span class:list={[row.tone === "error" && "red", row.tone === "ok" && "ok"]}>{row.key}</span>
                        <span>{row.text}</span>
                      </div>
                    ))}
                  </div>
                  <pre class:list={["run-raw", r.stream === "stderr" && r.raw && "red", !r.raw && "faint"]}>{r.raw.trim() || "(no output)"}</pre>
                </div>
              ))}
            </div>
          ))
        }

        <div class="loop-foot">
          <div>
            <div class="tabs" role="radiogroup" aria-label="Read as">
              <span class="small read-as">Read as</span>
              <button type="button" role="radio" data-reader="person" aria-selected="true">Person</button>
              <button type="button" role="radio" data-reader="agent" aria-selected="false">Agent</button>
            </div>
            <span class="small" data-reader-note>rendered for you</span>
          </div>
          <button type="button" class="button button--ink next" data-next>Next step →</button>
        </div>
      </div>
    </section>

    <section class="sec" id="diff">
      <div class="sec__row">
        <div class="sec__head">
          <h2 class="h2">Does the edit reach anyone?</h2>
          <p class="p">Pick an edit and see who has to rebuild.</p>
        </div>
        <div class="tabs diff-options" role="radiogroup" aria-label="Edit" id="diffopts">
          {
            diffs.map((d, i) => (
              <button type="button" role="radio" data-edit={d.key} aria-selected={i === 0 ? "true" : "false"}>
                {d.label}
              </button>
            ))
          }
        </div>
      </div>
      <div id="diffbox">
        {
          diffs.map((d) => (
            <div class="diff-panel" data-edit-panel={d.key}>
              <h3 class="diff-title">{d.label}</h3>
              <div class="diff">
                <div class="diff-code">
                  <div class="loop-file split-file">
                    <span>$ {d.frame.command}</span>
                  </div>
                  <pre class="diff-out">{d.output}</pre>
                </div>
                <div class="diff-consumers">
                  <div class="loop-file">imports {editedModule}</div>
                  {consumers.map((name) => (
                    <div>
                      <span>{name}</span>
                      <span class:list={["chip", d.moved ? "chip--warn" : "chip--ok"]}>
                        {d.moved ? "rebuild" : "up to date"}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
              <div class:list={["verdict", d.moved ? "verdict--warn" : "verdict--ok"]}>
                <b>{d.verdict}</b>
                <span class="mono">iyi mod diff · interface {d.moved ? "changed" : "unchanged"}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sec split">
      <div class="sec__head">
        <h2 class="h2">How the numbers were measured.</h2>
        <p class="p">
          The saving is a property of scale, so it is measured on the
          repository's own <Measure of="modules" />-module project, by a gate
          that runs both arms.
        </p>
        <p class="p note">
          The project is <code>records/agent/</code> in this site's
          repository. <a href={`${base}install/`}>Install the compiler</a> and
          the frames on this page are what you will see.
        </p>
      </div>
      <div class="card receipt">
        <div class="receipt-head">
          <span>{facts.provenance.generator}</span>
          <span>{facts.provenance.commit}</span>
        </div>
        <dl>
          <div><dt>project</dt><dd><Measure of="modules" /> modules · <Measure of="generated" /> lines</dd></div>
          <div><dt>runs</dt><dd>{pack.runs}</dd></div>
          <div><dt>arm A</dt><dd>sources</dd></div>
          <div><dt>arm B</dt><dd>iyi mod context</dd></div>
          <div><dt>pack size</dt><dd>{pack.size_low}–{pack.size_high}% of sources</dd></div>
          <div><dt>rounds to green (the model's)</dt><dd>tied {pack.rounds_tied} · lost {pack.rounds_lost}</dd></div>
        </dl>
        <div class="receipt-foot">
          <span>prompt tokens</span>
          <b>−{pack.tokens_low} to −{pack.tokens_high}%</b>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { wireAgentsPage } from "../lib/agents-page";
    wireAgentsPage();
  </script>

  <style>
    .agents-hero {
      max-width: none;
    }

    .agents-copy {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 760px;
    }

    .agents-copy .h1 {
      font-size: clamp(34px, 4.4vw, 54px);
    }

    /* The race ---------------------------------------------------------- */

    .race {
      margin-top: clamp(16px, 3vw, 32px);
      border-radius: 18px;
      padding: 1px;
      background: var(--panel-frame);
      box-shadow: var(--panel-shadow);
    }

    .race-in {
      border-radius: 17px;
      background: var(--code);
      color: var(--ink);
      overflow: hidden;
    }

    .race-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px 20px;
      padding: 12px 18px;
      border-bottom: var(--hair) solid var(--hairline);
      font-family: var(--font-mono);
      font-size: 12.5px;
      color: var(--mute);
    }

    .race-top > span {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .race-title {
      color: var(--ink);
    }

    .race-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--warn);
    }

    .race-dot[data-done="true"] {
      background: var(--ok);
    }

    .race-replay {
      display: none;
      align-items: center;
      gap: 6px;
      appearance: none;
      cursor: pointer;
      padding: 5px 10px;
      border-radius: 7px;
      border: var(--hair) solid var(--boundary);
      background: none;
      color: var(--ink);
      font: 600 12.5px var(--font-sans);
    }

    .race[data-js="true"] .race-replay {
      display: inline-flex;
    }

    .race-replay svg {
      width: 12px;
      height: 12px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .lanes {
      display: flex;
      flex-wrap: wrap;
    }

    .lane {
      position: relative;
      flex: 1 1 420px;
      min-width: 0;
      height: 300px;
      overflow: hidden;
      border-right: var(--hair) solid var(--hairline);
      transition: background 0.4s;
    }

    .lane[data-lane="1"] {
      background: color-mix(in srgb, var(--ok-soft) 45%, transparent);
    }

    .lane-text {
      position: absolute;
      left: 0;
      right: 0;
      top: 52px;
      bottom: 150px;
      padding: 0 20px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      font-family: var(--font-mono);
      pointer-events: none;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 45%, #000 80%, transparent);
      mask-image: linear-gradient(180deg, transparent, #000 45%, #000 80%, transparent);
    }

    .lane[data-lane="0"] .lane-text {
      font-size: 10.5px;
      line-height: 1.35;
      color: var(--mute);
    }

    .lane[data-lane="1"] .lane-text {
      font-size: 12.5px;
      line-height: 1.9;
      color: var(--graphite);
    }

    .lane-text :global(div) {
      flex: none;
      white-space: pre;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .lane-ui {
      position: relative;
      height: 100%;
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .lane-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }

    .lane-head b {
      font-size: 14px;
      font-weight: 650;
      color: var(--graphite);
    }

    .lane[data-lane="1"] .lane-head b {
      color: var(--brand-deep);
    }

    .lane-head span {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--mute);
    }

    .lane-foot {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .lane-num {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }

    .lane-num b {
      font: 500 clamp(52px, 7vw, 84px) / 0.9 var(--font-mono);
      letter-spacing: -0.03em;
      font-variant-numeric: tabular-nums;
    }

    .lane-num span {
      font-size: 13px;
      color: var(--graphite);
    }

    .lane-bar {
      height: 8px;
      border-radius: 999px;
      background: var(--hairline);
      overflow: hidden;
    }

    .lane-bar i {
      display: block;
      height: 100%;
      border-radius: 999px;
      background: var(--mute);
      transition: width 0.2s linear;
    }

    .lane[data-full="true"] .lane-bar i {
      background: var(--graphite);
    }

    .lane[data-lane="1"] .lane-bar i {
      background: var(--ok);
    }

    .lane-steps {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .lane-steps button {
      appearance: none;
      border: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 999px;
      font: 11.5px var(--font-mono);
      color: var(--mute);
      background: var(--raise);
    }

    .lane-steps button[data-state="done"],
    .lane-steps button[data-state="active"] {
      color: var(--ink);
      background: var(--hairline);
    }

    .lane-steps button span::before {
      content: "·";
    }

    .lane-steps button[data-state="active"] span::before {
      content: "…";
    }

    .lane-steps button[data-state="done"] span::before {
      content: "✓";
      color: var(--ok);
    }

    .race-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 20px;
      padding: 16px 20px;
      border-top: var(--hair) solid var(--hairline);
      min-height: 66px;
      background: var(--raise);
      transition: background 0.4s;
    }

    .race-foot[data-done="true"] {
      background: var(--ok-soft);
    }

    .race-foot p {
      margin: 0;
      width: 100%;
    }

    .when-done {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px 20px;
    }

    .when-done b {
      font-weight: 750;
      font-stretch: 108%;
      font-size: clamp(20px, 2.4vw, 28px);
      letter-spacing: -0.025em;
    }

    .race-hint {
      margin-left: auto;
      font-size: 13px;
      color: var(--graphite);
    }

    .when-running {
      font-size: 15px;
      color: var(--graphite);
    }

