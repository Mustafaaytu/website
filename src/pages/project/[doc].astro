---
/**
 * One of the repository's project documents, published whole.
 *
 * Every block is a block of the file, in the file's order, out of
 * src/generated/project.json. scripts/project.mjs proves the blocks reassemble
 * into the file byte for byte before it writes them, so this page cannot be
 * showing a document with a paragraph missing.
 *
 * Nothing is summarised, reordered or "adapted for the web". A security policy
 * a site paraphrases is a security policy that sends somebody's disclosure to
 * the wrong mailbox.
 */
import Page from "../../layouts/Page.astro";
import Lifted from "../../components/Lifted.astro";
import project from "../../generated/project.json";

const base = import.meta.env.BASE_URL;

interface Block {
  kind: string;
  level?: number;
  html?: string;
  text?: string;
  lang?: string;
  ordered?: boolean;
  items?: string[];
  from: number;
  to: number;
}

interface Document {
  id: string;
  file: string;
  title: string;
  blurb: string;
  lines: number;
  cite: string;
  url: string;
  blocks: Block[];
}

export function getStaticPaths() {
  return project.documents.map((document) => ({
    params: { doc: document.id },
    props: { document },
  }));
}

const doc = Astro.props.document as unknown as Document;

/* The title is the document's own first heading and this page sets it as the
 * page heading, so it is not rendered twice. */
const body = doc.blocks.filter(
  (block, index) => !(index === 0 && block.kind === "heading" && block.level === 1),
);

const others = project.documents.filter((entry) => entry.id !== doc.id);
---

<Page
  kind="TechArticle"
  title={doc.title}
  summary={`${doc.blurb} Published verbatim from ${doc.file} in the iyi repository, ${doc.lines} lines, reassembled byte for byte at build time.`}
>
  <div class="wrap">
    <div class="doc">
      <header class="doc-head">
        <p class="small">
          <a href={`${base}project/`}>Project</a>, verbatim
        </p>
        <h1 class="h1">{doc.title}</h1>
        <p class="lead">{doc.blurb}</p>
      </header>

      <article class="prose doc-body">
        <p>Published whole, out of <a href={doc.url}>{doc.cite}</a>.</p>
        {body.map((block) => {
          if (block.kind === "heading") {
            /* A comparison with `<` inside the template is read as the start
             * of a tag by Astro's parser, so the level picks its element here
             * and the element is rendered by name. The document's own h1 is
             * the page heading, so everything below it moves down one. */
            const Heading = block.level === 3 ? "h3" : block.level === 4 ? "h4" : "h2";
            return <Heading set:html={block.html ?? ""} />;
          }
          if (block.kind === "paragraph") return <p set:html={block.html ?? ""} />;
          if (block.kind === "list") {
            return block.ordered ? (
              <ol>{(block.items ?? []).map((item) => <li set:html={item} />)}</ol>
            ) : (
              <ul>{(block.items ?? []).map((item) => <li set:html={item} />)}</ul>
            );
          }
          if (block.kind === "code") {
            return (
              <Lifted
                text={block.text ?? ""}
                caption={doc.file}
                cite={`${doc.file}, lines ${block.from} to ${block.to}`}
                href={doc.url}
              />
            );
          }
          if (block.kind === "rule") return <hr class="doc-rule" />;
          /* A link definition block and an HTML comment render as nothing:
           * they are the document's plumbing, already resolved into the links
           * above. */
          return null;
        })}

        <h2>The rest</h2>
        <ul class="others">
          {others.map((entry) => (
            <li>
              <a href={`${base}project/${entry.id}/`}>{entry.title}</a>
              <span>{entry.blurb}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>

  <style>
    .doc {
      max-width: 820px;
      padding-top: clamp(32px, 5vw, 56px);
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .doc-head {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .doc-head .small {
      margin: 0;
    }

    .doc-head .small a {
      color: inherit;
      text-decoration: none;
    }

    .doc-body {
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-width: 0;
    }

    .doc-body > :global(*) {
      margin: 0;
    }

    .doc-body :global(p) {
      font-size: 16.5px;
      line-height: 1.7;
      color: var(--ink);
      opacity: 0.92;
      max-width: none;
    }

    .doc-body :global(h2),
    .doc-body :global(h3),
    .doc-body :global(h4) {
      margin-top: 20px;
      font-size: 22px;
      font-weight: 650;
      font-stretch: normal;
      letter-spacing: -0.02em;
      line-height: 1.3;
    }

    /* Every list is the redesign's ruled list: one item per row, hairlines
     * between them. */
    .doc-body :global(ul),
    .doc-body :global(ol) {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
    }

    .doc-body :global(li) {
      padding: 16px 0;
      border-top: var(--hair) solid var(--hairline);
      font-size: 16px;
      line-height: 1.6;
      color: var(--graphite);
    }

    .doc-body :global(li:last-child) {
      border-bottom: var(--hair) solid var(--hairline);
    }

    .doc-rule {
      border: 0;
      height: var(--hair);
      background: var(--hairline);
    }

    .others li {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .others a {
      font-weight: 600;
      color: var(--ink);
    }

    .others span {
      font-size: 15px;
    }
  </style>
</Page>
