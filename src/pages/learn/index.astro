---
/**
 * The path.
 *
 * Not a card grid and not a directory listing: a numbered walk with one
 * starting point, where reading step three assumes you read step two. The step
 * number is the `order` in the lesson's own frontmatter, checked by
 * src/lib/lessons.ts to be unique and gapless, so the number on this page is
 * the number in the file.
 *
 * The rule each step teaches is named beside it, carrying SPEC.md's own
 * sentence, read out of SPEC.md's rule table and its section headings by
 * scripts/samples.mjs. The rejection each step ends on is named too, carrying
 * the title of a case in records/diagnostics.json, so the index cannot
 * promise a recorded diagnostic that nobody ran.
 *
 * There are two tracks and this page shows both, because the rules are not the
 * syntax and a reader arrives wanting one or the other. The second is the
 * tour, which lives under /playground/: its sections and its steps are read
 * out of samples/tour/tour.json through src/playground/samples.ts, resolved
 * against the wasm recording there, so a step this page offers is a step that
 * has a page and a recorded run.
 */
import { Image } from "astro:assets";
import Measure from "../../components/Measure.astro";
import TourGrid from "../../components/TourGrid.astro";
import mascot from "../../assets/mascot.png";
import Page from "../../layouts/Page.astro";
import {
  sequence,
  rulesOf,
  breakCases,
  inlineMarkdown,
  lessonHref,
  SPELLED,
} from "../../lib/lessons";
import {
  playgroundHref,
  runnable,
  tourSamples,
  tourSections,
} from "../../playground/samples";
import { recordedText } from "../../lib/highlight";

const lessons = await sequence();
const base = import.meta.env.BASE_URL;
const playground = `${base.replace(/\/$/, "")}/playground/`;

const steps = lessons.map((lesson, i) => ({
  lesson,
  href: lessonHref(base, lesson),
  rules: rulesOf(lesson),
  broken: breakCases(lesson),
  next: lessons[i + 1],
}));

const [first] = steps;
const spelled = SPELLED[steps.length] ?? String(steps.length);
const count = `${spelled[0].toUpperCase()}${spelled.slice(1)}`;

// The other track. Every step carries its own page under /playground/, so the
// href is the recording's, not a guess: `playgroundHref` answers null for a
// program the wasm record does not cover, and a section that lost a step to
// that would be offering a link to nothing, so it is a build failure here.
const tour = tourSections.map((section) => ({
  title: section.title,
  blurb: section.blurb,
  steps: section.steps.map((step) => {
    const href = playgroundHref(step.id) ?? `${playground}${step.id}/`;
    return { id: step.id, href, runs: runnable(step) };
  }),
}));

const tourStart = tour[0]?.steps[0];

// A rule's premise as SPEC.md states it, cut to its first three sentences
// where it runs long: the step's own page carries the whole of it, and the
// index links there rather than reprinting a paragraph.
const LONG = 400;
function excerpt(premise: string): { text: string; cut: boolean } {
  if (premise.length <= LONG) return { text: premise, cut: false };
  let at = -1;
  for (let i = 0; i < 3; i++) {
    const next = premise.indexOf(". ", at + 1);
    if (next === -1) return { text: premise, cut: false };
    at = next;
  }
  return { text: premise.slice(0, at + 1), cut: true };
}

// The steps that ran natively rather than in the browser, named under the
// grid rather than typed into the note.
const nativeIds = tourSamples.filter((step) => !runnable(step)).map((step) => step.id);
if (tourStart === undefined) {
  throw new Error(
    "samples/tour/tour.json laid out no sections, so this page would offer a " +
      "second track with no way into it",
  );
}

// A program's own opening sentence, read out of the highlight recording rather
// than described here, so a sample that changes what it documents changes this
// page with it. The leading comment block is joined before the sentence is cut,
// because a comment wraps at the file's column and a first line is a fragment
// as often as it is a sentence: webapp.iyi's runs onto its second line, and
// showing only the first left the page ending on "injected by".
function opening(path: string): string {
  const lines: string[] = [];
  for (const line of recordedText(path).split("\n")) {
    const comment = /^#\s?(.*)$/.exec(line);
    if (comment === null) break;
    if (comment[1].trim() === "") break;
    lines.push(comment[1].trim());
  }
  const joined = lines.join(" ");
  const stop = joined.indexOf(". ");
  const sentence = stop === -1 ? joined : joined.slice(0, stop + 1);
  if (sentence === "") {
    throw new Error(
      `${path} opens with no comment, so this page has nothing to say about ` +
        `it that the file says itself. Describe it in the file, not here.`,
    );
  }
  return sentence;
}

// The samples a lesson does not stand on, each linked where it can be run.
// Named here rather than in a paragraph so the page cannot offer a program the
// recording has no module for, which is how the old closing paragraph sent a
// reader to a directory listing that does not exist on this site.
const grounded = new Set(lessons.map((lesson) => lesson.data.sample));
const further = [
  "samples/iyi/collections.iyi",
  "samples/iyi/immutable.iyi",
  "samples/iyi/init_order.iyi",
  "samples/iyi/webapp.iyi",
]
  .filter((path) => !grounded.has(path))
  .map((path) => {
    const href = playgroundHref(path);
    if (href === null) {
      throw new Error(
        `this page offers ${path} as somewhere to go next and the wasm ` +
          `recording has no module for it, so the link would not run. Either ` +
          `record it or name a different sample.`,
      );
    }
    return { name: path.replace(/^samples\/iyi\//, ""), href, blurb: opening(path) };
  });
---

<Page
  kind="CollectionPage"
  title="Learn iyi"
  summary={`${count} steps in order, one rule each. Compile against declarations rather than bodies, write down what you export, own your own names, replace open classes with traits, type a body where it is written, cross a boundary with a generic, keep a macro to one declaration, and return errors as ordinary values.`}
>
  <div class="wrap">
    <section class="page-hero">
      <p class="eyebrow">
        <Image src={mascot} alt="" width={20} height={19} densities={[1, 2]} loading="eager" decoding="async" />
        Learn
      </p>
      <h1 class="h1">{count} steps, one rule each</h1>
      <p class="lead">
        iyi is Crystal with one rule added, and that rule changes enough that
        starting from the syntax would teach you the wrong thing. So these
        steps start from the rule, in the order the rules depend on each other.
      </p>
      <p class="p">
        Each step opens with the rule in the specification's own words, shows
        the program it is grounded in, breaks the rule on purpose, and prints
        what the compiler said. Every listing is read out of the repository
        when the page is built, and every error is a recording of a real run.
      </p>
      <div class="btns">
        <a class="button" href={first.href}>Start at step one →</a>
        <a class="button button--ghost" href={tourStart.href}>Or start with the syntax</a>
      </div>
    </section>

    <section class="sec">
      <div class="sec__row">
        <div class="sec__head">
          <h2 class="h2">The path</h2>
          <p class="p">
            Each identifier is the specification's own, and the sentence it
            states for it is beside the step.
          </p>
        </div>
        <nav class="path" aria-label="Steps">
          {
            steps.map(({ lesson, rules }) => (
              <a href={`#step-${lesson.data.order}`}>
                <span>{lesson.data.order}</span>
                {rules.map((rule) => rule.id).join(" ")}
              </a>
            ))
          }
        </nav>
      </div>

      <ol class="steps">
        {
          steps.map(({ lesson, href, rules, broken }) => (
            <li class="step" id={`step-${lesson.data.order}`}>
              <div class="step-n">
                <b>{lesson.data.order}</b>
                {rules.map((rule) => (
                  <span class="chip chip--red">{rule.id}</span>
                ))}
              </div>
              <div class="step-body">
                <h3 class="h3">
                  <a href={href}>{lesson.data.title}</a>
                </h3>
                <p class="p" set:html={inlineMarkdown(lesson.data.summary)} />
                {rules.map((rule) => {
                  const shown = excerpt(rule.premise);
                  return (
                    <p class="rule-quote">
                      <Fragment set:html={inlineMarkdown(shown.text)} />
                      {shown.cut && (
                        <>
                          {" "}
                          <a href={href}>The full rule →</a>
                        </>
                      )}
                    </p>
                  );
                })}
                <div class="meta">
                  <span>
                    <b>grounded in</b>
                    <code>{lesson.data.sample}</code>
                  </span>
                  <span>
                    <b>breaks</b>
                    {broken.map((entry) => entry.title).join(" · ")}
                  </span>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sec">
      <div class="sec__head">
        <p class="eyebrow">The second track</p>
        <h2 class="h2">The syntax, in {tourSamples.length} short programs</h2>
        <p class="p">
          The rules are what make iyi a different language from the one it
          forked. The tour is everything else, in the order a person learns a
          language, each program running in your browser. Read the rules first
          and the tour reads as confirmation. Read the tour first and the rules
          read as the reason.
        </p>
      </div>
      <TourGrid variant="chips" heading="h3" />
      <div class="track-foot">
        {
          nativeIds.length > 0 ? (
            <span class="small">
              <em class="key">native</em> {nativeIds.join(" and ")}{" "}
              {nativeIds.length === 1 ? "has" : "have"} no wasm target yet, so{" "}
              {nativeIds.length === 1 ? "it shows" : "those show"} what the
              program printed natively.
            </span>
          ) : (
            <span />
          )
        }
        <a class="button" href={tourStart.href}>Start the tour at {tourStart.id} →</a>
      </div>
    </section>

    <section class="sec">
      <div class="sec__head">
        <p class="eyebrow">And the rest of the samples</p>
        <p class="p">
          Beyond both tracks, <code>samples/iyi</code> holds{" "}
          <Measure of="samples" /> programs, each written to document a part
          of the design. The ones no step is grounded in are the ones to read
          next:
        </p>
      </div>
      <ul class="list">
        {
          further.map((sample) => (
            <li>
              <a href={sample.href}><code>{sample.name}</code></a>
              <span class="p">{sample.blurb}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Page>

<style>
  .path {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .path a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 9px;
    border: var(--hair) solid var(--hairline);
    background: var(--card);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink);
    text-decoration: none;
  }

  .path a:hover {
    border-color: var(--mute);
    color: var(--ink);
  }

  .path a span {
    color: var(--mute);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 20px;
    padding: 22px;
    border-radius: var(--radius-lg);
    border: var(--hair) solid var(--hairline);
    background: var(--card);
    scroll-margin-top: 80px;
  }

  .step-n {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .step-n b {
    font: 500 28px var(--font-mono);
    line-height: 1;
  }

  .step-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .step-body h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .step-body h3 a:hover {
    color: var(--brand-deep);
  }

  .rule-quote {
    margin: 0;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--raise);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: 13px;
    color: var(--graphite);
  }

  .meta span {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .meta b {
    font-weight: 500;
    color: var(--mute);
    white-space: nowrap;
  }

  @media (max-width: 599px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .step-n {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }
  }

  .list a {
    text-decoration: none;
  }

  .track-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .key {
    margin-right: 6px;
    font-style: normal;
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--warn-soft);
    color: var(--warn);
    font-family: var(--font-mono);
  }
</style>
