---
/**
 * One step of the path.
 *
 * Every step is set to the same shape, and the shape is rendered here rather
 * than left to each lesson's prose, so a reader who has read one knows where to
 * look in the next:
 *
 *   1. what the rule says, in the specification's own words, read out of
 *      SPEC.md at build time and carrying the line it is stated on;
 *   2. the program the step is grounded in, transcluded from samples/iyi, with
 *      a link into the playground where the wasm record says it runs;
 *   3. the lesson itself;
 *   4. break the rule: a program in the tree written to be rejected, and the
 *      verdict a real compiler gave it, recorded byte for byte, once per case
 *      recorded under a rule this step teaches;
 *   5. what the rule bought.
 *
 * Previous and next come from `order`, so the sequence on the page is the
 * sequence in the files rather than a hand maintained pair of links, and the
 * forward link carries the next step's own summary because a path should tell
 * you where it goes.
 *
 * Two things the markdown pipeline leaves undone are done here. It slugs every
 * heading and emits nothing that links to a slug, so the `##` and `###` of a
 * lesson are mapped onto `_Heading.astro`, which hangs a link on the id the
 * pipeline already put there. And the same slugs are listed in the rail as the
 * step's own contents, read off the rendered entry, so the list and the page
 * cannot drift. No reading time anywhere: doc/ART-DIRECTION.md forbids a time
 * estimate in copy, and how long a rule takes to learn is not this page's
 * claim to make.
 *
 * Markdown element styles come from the global `.prose` class in styles. This
 * page styles its own chrome and the spacing around the site's code components,
 * and nothing else.
 */
import { render } from "astro:content";
import Page from "../../layouts/Page.astro";
import BreakRule from "../../components/BreakRule.astro";
import H2 from "./_H2.astro";
import H3 from "./_H3.astro";
import {
  sequence,
  rulesOf,
  runOf,
  breakCases,
  inlineMarkdown,
  lessonHref,
  type Lesson,
} from "../../lib/lessons";

export async function getStaticPaths() {
  const lessons = await sequence();

  return lessons.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: {
      lesson,
      previous: i > 0 ? lessons[i - 1] : undefined,
      next: i + 1 < lessons.length ? lessons[i + 1] : undefined,
      total: lessons.length,
    },
  }));
}

interface Props {
  lesson: Lesson;
  previous?: Lesson;
  next?: Lesson;
  total: number;
}

const { lesson, previous, next, total } = Astro.props;
const { Content, headings } = await render(lesson);

/* The step's own sections, read off the rendered entry, so a contents entry
 * and the heading it names cannot disagree. */
const sections = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const base = import.meta.env.BASE_URL;
const rules = rulesOf(lesson);
const run = runOf(lesson);
const sources = lesson.data.sources ?? [];
const indexHref = `${base.replace(/\/$/, "")}/learn/`;

// Every recorded rejection this step shows. The first is the one the lesson's
// closing paragraph leads into and the one that carries the extra files the
// rejection needs to make sense; the rest are further cases recorded under the
// same rule, shown after it rather than left in the record unrendered.
const broken = breakCases(lesson);

/* Every step, with the rules it teaches, for the path across the top. */
const steps = (await sequence()).map((step) => ({
  lesson: step,
  rules: rulesOf(step).map((rule) => rule.id).join(" "),
}));
---

<Page
  kind="TechArticle"
  title={`${lesson.data.title}, learn iyi`}
  summary={lesson.data.summary.replace(/`/g, "")}
>
  <div class="wrap">
    <article class="lesson">
      <nav class="path" aria-label="Steps">
        {
          steps.map((step) => (
            <a
              href={lessonHref(base, step.lesson)}
              aria-current={step.lesson.id === lesson.id ? "page" : undefined}
            >
              <span>{step.lesson.data.order}</span>
              {step.rules}
            </a>
          ))
        }
      </nav>

      <header class="lesson-head">
        <p class="small">
          <a href={indexHref}>Learn</a> · step {lesson.data.order} of {total}
        </p>
        <h1 class="h1">{lesson.data.title}</h1>
        <p class="lead" set:html={inlineMarkdown(lesson.data.summary)} />
        {
          sections.length > 0 && (
            <nav class="toc" aria-label="In this step">
              <span class="small">In this step</span>
              {sections.map((heading) => (
                <a href={`#${heading.slug}`} class:list={{ deep: heading.depth === 3 }}>
                  {heading.text}
                </a>
              ))}
            </nav>
          )
        }
      </header>

      <div class="lesson-body">
        <p class="eyebrow">What the rule says</p>
        {
          rules.map((rule) => (
            <blockquote class="premise">
              <span class="chip chip--red">{rule.id}</span>{" "}
              <span set:html={inlineMarkdown(rule.premise)} />
              <cite>
                <span>{rule.id}</span> {rule.cite}
              </cite>
            </blockquote>
          ))
        }

        <p class="eyebrow">Run it</p>
        <p class="lp">
          This step is grounded in <code>{run.path}</code>, {run.lines} lines in
          the repository, read out of the tree when this page is built.
        </p>
        <p class="lp">
          {
            run.href ? (
              <Fragment>
                <a href={run.href}>Run it in your browser</a>
                <span> from the module the compiler built for it.</span>
              </Fragment>
            ) : (
              <span>
                This program does not run in the browser. Locally it is{" "}
                <code>iyi run {run.path}</code>.
              </span>
            )
          }
        </p>
        {run.note && <p class="lp note">{run.note}</p>}

        <div class="prose">
          {/* The headings carry a link to themselves, which is the one thing
            * the markdown pipeline does not render. Mapped rather than written
            * into each lesson, so a new lesson gets it by existing. */}
          <Content components={{ h2: H2, h3: H3 }} />
        </div>

        {
          broken.map((entry, i) => (
            <BreakRule id={entry.id} also={i === 0 ? lesson.data.breaksAlso : undefined} />
          ))
        }

        <p class="eyebrow">What the rule bought</p>
        <p class="lp" set:html={inlineMarkdown(lesson.data.bought)} />

        {
          /* Provenance at the foot. The listings and the quoted recordings
           * already print their own file and lines where they sit, so this is
           * the shorter list of what the prose leans on without showing. */
          sources.length > 0 && (
            <Fragment>
              <p class="eyebrow">Standing on</p>
              <dl class="sources">
                {sources.map((source) => (
                  <div>
                    <dt><code>{source.file}</code></dt>
                    <dd set:html={inlineMarkdown(source.note)} />
                  </div>
                ))}
              </dl>
            </Fragment>
          )
        }
      </div>

      <nav class="pager" aria-label="Sequence">
        {
          previous ? (
            <a class="button button--ghost" href={lessonHref(base, previous)}>
              ← {previous.data.order}. {previous.data.title}
            </a>
          ) : (
            <a class="button button--ghost" href={indexHref}>← All steps</a>
          )
        }
        {
          next ? (
            <a class="button" href={lessonHref(base, next)}>
              {next.data.order}. {next.data.title} →
            </a>
          ) : (
            <a class="button" href={`${base.replace(/\/$/, "")}/playground/`}>The syntax tour →</a>
          )
        }
      </nav>
    </article>
  </div>
</Page>

<style>
  .lesson {
    max-width: 820px;
    padding-top: clamp(32px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .path {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .path a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 9px;
    border: var(--hair) solid var(--hairline);
    background: var(--card);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink);
    text-decoration: none;
  }

  .path a:hover {
    border-color: var(--mute);
    color: var(--ink);
  }

  .path a span {
    color: var(--mute);
  }

  .path a[aria-current="page"] {
    border-color: var(--brand);
    background: var(--brand-soft);
  }

  .lesson-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lesson-head .small {
    margin: 0;
  }

  .lesson-head .small a {
    color: inherit;
    text-decoration: none;
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding-top: 4px;
  }

  .toc .small {
    margin-right: 2px;
  }

  .toc a {
    font-size: 14px;
    color: var(--graphite);
    text-decoration: none;
    border-bottom: var(--hair) solid var(--boundary);
  }

  .toc a:hover {
    color: var(--ink);
  }

  .toc a.deep {
    color: var(--mute);
  }

  .lesson-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  /* Every label a lesson carries, its own and the ones BreakRule prints, is
   * the redesign's eyebrow: sentence case, the accent, and room above it. */
  .lesson-body .eyebrow,
  .lesson-body :global(.label) {
    margin: 28px 0 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--brand-deep);
  }

  .lesson-body :global(hr.rule) {
    display: none;
  }

  .premise {
    margin: 0;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--raise);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }

  .premise .chip {
    margin-right: 6px;
  }

  .premise cite {
    display: block;
    margin-top: 8px;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
  }

  .premise cite span {
    color: var(--ink);
    font-weight: 600;
  }

  .lp,
  .prose :global(p),
  .prose :global(li) {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.92;
    max-width: none;
  }

  .lp :global(code),
  .prose :global(p code),
  .prose :global(li code) {
    font-size: 0.88em;
  }

  .note {
    font-size: 15px;
    color: var(--graphite);
  }

  /* The lesson's own prose: one column, the same rhythm as the blocks around
   * it, and its headings at the size the redesign sets them. */
  .prose {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .prose > :global(*) {
    margin: 0;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 20px;
    font-size: 24px;
    font-weight: 650;
    font-stretch: normal;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .prose :global(h3) {
    font-size: 20px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .lesson-body :global(.source pre),
  .lesson-body :global(.console pre) {
    font-size: 12.5px;
  }

  .lesson-body :global(.break) {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .lesson-body :global(.break-title) {
    margin: 20px 0 0;
    font-size: 24px;
    font-weight: 650;
    font-stretch: normal;
  }

  .lesson-body :global(.break .source),
  .lesson-body :global(.break .diagnostic) {
    margin: 0;
  }

  .sources {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: var(--hair) solid var(--hairline);
  }

  .sources div {
    display: grid;
    grid-template-columns: minmax(140px, 220px) minmax(0, 1fr);
    gap: 6px 20px;
    padding: 12px 0;
    border-bottom: var(--hair) solid var(--hairline);
    font-size: 14.5px;
    line-height: 1.55;
  }

  .sources dt code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .sources dd {
    margin: 0;
    color: var(--graphite);
  }

  @media (max-width: 599px) {
    .sources div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pager .button {
    height: auto;
    min-height: 44px;
    padding-block: 10px;
    line-height: 1.3;
  }
</style>
