---
/* Fonts are vendored, never fetched from a CDN. A site arguing that a program
 * should link what it uses does not get to pull webfonts off a third party.
 *
 * One import, and it is generated. `scripts/fonts.mjs` reads the installed
 * @fontsource packages and writes every @font-face this site needs, woff2
 * only, latin and latin-ext only. Importing the packages' own stylesheets, as
 * this file used to, shipped a legacy .woff beside every face that no browser
 * capable of rendering this site would ever ask for, and pulled the cyrillic,
 * cyrillic-ext and vietnamese subsets in behind them: two thirds of the font
 * payload, for alphabets no page here contains. latin-ext is not optional and
 * doc/ART-DIRECTION.md says why: the project's name is Turkish. */
import "../generated/fonts.css";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/code.css";
import "../styles/site.css";
import "../styles/print.css";

/* The two faces every page needs before it can draw a word: the variable sans
 * the prose is set in and the mono the code is set in, latin in both cases.
 * They are discovered otherwise only after the stylesheet has been fetched and
 * parsed, which is one round trip after the browser could have started them.
 * The latin-ext files are left to be discovered: a page with no Turkish
 * letter on it never asks for them. `crossorigin`
 * is required even same-origin, because fonts are fetched in CORS mode and a
 * preload without it fetches the file a second time. */
import sansLatin from "@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2";

import { Image } from "astro:assets";
import mascot from "../assets/mascot.png";

import facts from "../generated/facts.json";
import { latestRelease, releaseUrl } from "../lib/release";

/* The browser chrome's colour, read out of the stylesheet that decides it.
 * `<meta name="theme-color">` takes a literal and nothing else, so the only
 * way it is not a second place for the palette to disagree with itself is to
 * read the first place. Renaming a token here fails the build rather than
 * leaving a red bar over a white page, which is what this meta said before:
 * #d1333d, a colour that appears nowhere along the top of any page on the
 * site. It matches the masthead now, in each scheme. */
import tokensCss from "../styles/tokens.css?raw";

const token = (name: string): string => {
  const found = new RegExp(`--${name}:\\s*(#[0-9a-fA-F]{3,8})\\s*;`).exec(tokensCss);
  if (!found) {
    throw new Error(
      `Page: src/styles/tokens.css declares no --${name}, so this page cannot ` +
        `tell the browser what colour to paint its chrome. The token was ` +
        `renamed or removed.`,
    );
  }
  return found[1];
};

const release = latestRelease();

interface Props {
  title: string;
  summary?: string;
  /** Schema.org type of the page's main content; WebPage unless a page says. */
  kind?: "WebPage" | "TechArticle" | "CollectionPage";
  /**
   * Whether this page is a URL a crawler should keep.
   *
   * True for every route the build emits. False for exactly one page, the 404:
   * Astro writes it to `dist/404.html` and GitHub Pages serves it in place of
   * any path that does not exist, so `/404/` is not a route this site has. A
   * self-canonical there points a crawler at a URL that is itself a missing
   * path, and asks it to index the result. When false this layout emits no
   * canonical, no `og:url` and a `robots` meta, because the page is real and
   * worth reading and simply is not an address.
   */
  indexable?: boolean;
}

const { title, summary, kind = "WebPage", indexable = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;
const here = Astro.url.pathname;

/* One title pattern for the whole site: the page, then the site, unless the
 * page is the site. */
const siteName = "iyi";
const isHome = here === base || here === href("/");
const fullTitle = isHome || title.endsWith(`| ${siteName}`) ? title : `${title} | ${siteName}`;
const canonical = new URL(here, Astro.site).href;
const ogImage = new URL(href("og.png"), Astro.site).href;

/* Structured data. The site and its subject on every page; the page itself
 * typed by what it is. Search engines and answer engines read this before
 * they read prose. */
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site,
      name: siteName,
      description:
        "iyi is a friendly, fast programming language for people and their agents, compatible with Crystal.",
      inLanguage: "en",
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${Astro.site}#iyi`,
      name: "iyi",
      description:
        "A compiled programming language whose modules compile against their dependencies' declarations, never their bodies. Compatible with Crystal: the same compiler builds .cr files, and iyi build --crystal gives a program Crystal's standard library and shards.",
      programmingLanguage: "iyi",
      codeRepository: "https://github.com/iyilang/iyi",
      version: release.version,
      dateModified: release.date,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      url: Astro.site,
      image: ogImage,
    },
    {
      "@type": kind,
      "@id": `${canonical}#page`,
      /* Dropped on a page that is not an address: the 404 is served at every
       * missing path, so naming one of them as its URL is a claim no crawler
       * can verify and this one would be false. */
      ...(indexable ? { url: canonical } : {}),
      name: fullTitle,
      description: summary,
      isPartOf: { "@id": `${Astro.site}#website` },
      about: { "@id": `${Astro.site}#iyi` },
      inLanguage: "en",
    },
  ],
};

const nav = [
  ["Why iyi", "why/"],
  ["Learn", "learn/"],
  ["Agents", "agents/"],
  ["Playground", "playground/"],
  ["Install", "install/"],
];

const current = (path: string) => here.startsWith(href(path));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {summary && <meta name="description" content={summary} />}
    {indexable && <link rel="canonical" href={canonical} />}
    {!indexable && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" as="font" type="font/woff2" href={sansLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin />

    <link rel="icon" href={href("favicon.ico")} sizes="48x48" />
    <link rel="icon" href={href("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={href("favicon-192.png")} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={href("apple-touch-icon.png")} sizes="180x180" />
    <link rel="manifest" href={href("site.webmanifest")} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />
    <meta name="theme-color" content={token("paper-dark")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    {indexable && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    {summary && <meta property="og:description" content={summary} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The iyi mascot, a waving red heart, beside the line: a friendly, fast language for people and their agents." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {summary && <meta name="twitter:description" content={summary} />}
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />

    {/* Google Analytics. `is:inline` keeps Astro from bundling the snippet:
     * gtag has to run as a classic script against a global, and a processed
     * module would not. Production only, so a local preview is not a visit. */}
    {
      import.meta.env.PROD && (
        <>
          <script async src="https://www.googletagmanager.com/gtag/js?id=G-TLLJKX51NY" is:inline></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-TLLJKX51NY');
          </script>
        </>
      )
    }
    {/* The stored scheme, applied before the first paint. Dark is what the
        stylesheet draws with nothing set, so only a reader who chose light
        has anything to restore, and restoring it after the body has painted
        is a flash of the wrong page on every load. Inline, because a bundled
        module runs too late to prevent that. */}
    <script is:inline>
      try {
        if (localStorage.getItem("iyi-theme") === "light") document.documentElement.dataset.theme = "light";
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="masthead-inner">
        <a class="wordmark" href={href("/")} aria-label="iyi, home">
          {/* 28px on the page, and served at the size it is drawn: `densities`
              asks astro:assets for the 1x and 2x it can actually use. Eager,
              because it is above the fold on every page. */}
          <Image
            src={mascot}
            alt=""
            width={28}
            height={26}
            densities={[1, 2]}
            loading="eager"
            decoding="async"
          />
          <span>iyi</span>
        </a>
        <nav id="site-nav" aria-label="Sections">
          <ul>
            {
              nav.map(([label, path]) => (
                <li>
                  <a href={href(path)} aria-current={current(path) ? "page" : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="https://github.com/iyilang/iyi">GitHub</a>
            </li>
          </ul>
        </nav>
        {/* Both controls are hidden until the script claims the masthead: a
            control that cannot remember a choice or unfold a menu is an
            ornament. Their marks are drawn, not typed, so no glyph falls back
            to whatever the reader's machine has. */}
        <div class="masthead-controls">
          <button
            type="button"
            class="icon-button scheme-toggle"
            data-paper={token("paper")}
            data-paper-dark={token("paper-dark")}
          >
            <svg class="to-dark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M14 8.53A6 6 0 1 1 7.47 2a4.67 4.67 0 0 0 6.53 6.53z" />
            </svg>
            <svg class="to-light" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <circle cx="8" cy="8" r="3" />
              <path
                d="M8 1.1V3.4M8 12.6V14.9M1.1 8H3.4M12.6 8H14.9M3.12 3.12l1.63 1.63M11.25 11.25l1.63 1.63M3.12 12.88l1.63-1.63M11.25 4.75l1.63-1.63"
              />
            </svg>
            <span class="visually-hidden">Switch the color scheme</span>
          </button>
          <button
            type="button"
            class="icon-button menu-toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Menu"
          >
            <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
        </div>
      </div>
    </header>

    <script>
      /* The menu folds only where a script can unfold it. Without one, the
       * nav stays in the page as a plain list, which is the honest fallback. */
      const header = document.querySelector<HTMLElement>(".masthead");
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      if (header && toggle) {
        header.dataset.js = "true";
        const set = (open: boolean) => {
          header.dataset.open = String(open);
          toggle.setAttribute("aria-expanded", String(open));
        };
        toggle.addEventListener("click", () => set(header.dataset.open !== "true"));
        header.querySelector("nav")?.addEventListener("click", (event) => {
          if ((event.target as HTMLElement).closest("a")) set(false);
        });
      }

      /* The scheme switch. The page is dark unless `<html>` says light, which
       * the inline script in the head has already restored from storage. All
       * this does is flip that attribute, remember it, and keep the browser
       * chrome's colour in step with the page. */
      const scheme = document.querySelector<HTMLButtonElement>(".scheme-toggle");
      if (header && scheme) {
        const root = document.documentElement;
        const paper = scheme.dataset.paper ?? "";
        const paperDark = scheme.dataset.paperDark ?? "";
        const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

        const apply = (want: "light" | "dark") => {
          if (want === "light") root.dataset.theme = "light";
          else delete root.dataset.theme;
          if (meta) meta.content = want === "dark" ? paperDark : paper;
          try {
            localStorage.setItem("iyi-theme", want);
          } catch {}
        };

        if (root.dataset.theme === "light" && meta) meta.content = paper;

        scheme.addEventListener("click", () => {
          apply(root.dataset.theme === "light" ? "dark" : "light");
        });
      }
    </script>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <div class="colophon-top">
          <div class="colophon-brand">
            <a class="wordmark wordmark--large" href={href("/")}>
              {/* At the foot of every page, so below the fold and lazy. */}
              <Image
                src={mascot}
                alt="The iyi mascot, a waving heart"
                width={40}
                height={37}
                densities={[1, 2]}
                loading="lazy"
                decoding="async"
              />
              <span>iyi</span>
            </a>
            {/* What the thing is, for a reader who landed on a deep page and
                scrolled to the bottom. The licence is one link away, at
                `/project/notice/`, rather than a second copy here. */}
            <p>
              <strong>iyi is Turkish for good.</strong> A fast, compiled
              language for developers and the agents working beside them, built
              on a single refusal: a module compiles against what its
              dependencies declare, never against what they do. Quick builds
              and small binaries follow from it.
            </p>
            <a class="button button--ink" href={href("install/")}>Install iyi →</a>
          </div>
          <nav class="colophon-links" aria-label="Footer">
            <ul>
              {
                nav.map(([label, path]) => (
                  <li>
                    <a href={href(path)}>{label}</a>
                  </li>
                ))
              }
            </ul>
            <ul>
              <li><a href="https://github.com/iyilang/iyi">Source on GitHub</a></li>
              <li><a href={href("project/notice/")}>License and notices</a></li>
            </ul>
          </nav>
        </div>
        <p class="colophon-bottom">
          <span>
            latest release <a href={releaseUrl(release)}>{release.version}</a> · {release.date}
          </span>
          <span>
            numbers on this site generated by {facts.provenance.generator} · measured at {facts.provenance.commit}
          </span>
        </p>
      </div>
    </footer>

    {/*
      Where every copy control's answer is spoken, and the only one on the
      page. `src/lib/copy.ts` writes into it; nothing else does. It has to be
      in the document before the text arrives, because a live region inserted
      together with its contents announces nothing.
    */}
    <p id="copy-status" class="visually-hidden" role="status" aria-live="polite"></p>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 16px;
        top: 12px;
        z-index: 50;
        background: var(--ink);
        color: var(--paper);
        padding: 8px 12px;
        border-radius: 8px;
      }

      /* Sticky and translucent: the page scrolls under a frosted bar. */
      .masthead {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--masthead);
        backdrop-filter: saturate(1.4) blur(16px);
        -webkit-backdrop-filter: saturate(1.4) blur(16px);
        border-bottom: var(--hair) solid var(--hairline);
      }

      .masthead-inner {
        max-width: calc(var(--page) + 2 * var(--edge));
        margin: 0 auto;
        min-height: 60px;
        padding: 0 var(--edge);
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
      }

      .wordmark {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--ink);
        font-weight: 800;
        font-size: 20px;
        letter-spacing: -0.03em;
        line-height: 1;
        text-decoration: none;
      }
      .wordmark:hover {
        color: var(--ink);
        text-decoration: none;
      }
      .wordmark :global(img) {
        display: block;
        width: 28px;
        height: auto;
      }

      .masthead nav {
        flex: 1;
      }
      .masthead nav ul {
        display: flex;
        gap: 2px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .masthead nav a {
        display: block;
        padding: 8px 11px;
        border-radius: 8px;
        font-size: 14.5px;
        font-weight: 500;
        color: var(--graphite);
        text-decoration: none;
      }
      .masthead nav a:hover,
      .masthead nav a[aria-current="page"] {
        color: var(--ink);
        background: var(--raise);
      }

      .masthead-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
      }

      /* A square with a control's own edge, so the scheme switch reads as a
       * button among the links rather than as an ornament beside them. */
      .icon-button {
        display: none;
        appearance: none;
        border: var(--hair) solid var(--boundary);
        background: var(--card);
        cursor: pointer;
        width: 38px;
        height: 38px;
        padding: 0;
        border-radius: 10px;
        color: var(--ink);
        align-items: center;
        justify-content: center;
      }
      .icon-button:hover {
        color: var(--ink);
        background: var(--raise);
        border-color: var(--graphite);
      }
      .masthead[data-js="true"] .scheme-toggle {
        display: flex;
      }

      .scheme-toggle svg {
        inline-size: 18px;
        block-size: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* The mark names the press, not the state: a dark page offers the sun. */
      .scheme-toggle .to-dark {
        display: none;
      }
      :root[data-theme="light"] .scheme-toggle .to-dark {
        display: block;
      }
      :root[data-theme="light"] .scheme-toggle .to-light {
        display: none;
      }

      .bars {
        display: grid;
        gap: 4px;
        width: 17px;
        color: var(--ink);
      }
      .bars i {
        display: block;
        height: 1.5px;
        background: currentColor;
        border-radius: 1px;
        transition: transform var(--quick), opacity var(--quick);
      }
      .masthead[data-open="true"] .bars i:nth-child(1) {
        transform: translateY(5.5px) rotate(45deg);
      }
      .masthead[data-open="true"] .bars i:nth-child(2) {
        opacity: 0;
      }
      .masthead[data-open="true"] .bars i:nth-child(3) {
        transform: translateY(-5.5px) rotate(-45deg);
      }

      /* Below the breakpoint the sections are a column of their own under the
       * bar. With scripts blocked they are simply there; with the script they
       * fold behind the menu button. */
      @media (max-width: 959px) {
        .masthead[data-js="true"] .menu-toggle {
          display: flex;
        }

        /* A thumb, not a pointer: both controls grow to the 44 by 44 target. */
        .icon-button {
          width: 44px;
          height: 44px;
        }
        .masthead nav {
          order: 3;
          flex-basis: 100%;
          margin: 0 calc(-1 * var(--edge));
          padding: 4px var(--edge) 18px;
          border-top: var(--hair) solid var(--hairline);
        }
        .masthead[data-js="true"] nav {
          display: none;
        }
        .masthead[data-open="true"] nav {
          display: block;
        }
        .masthead nav ul {
          flex-direction: column;
        }
        .masthead nav li + li {
          border-top: var(--hair) solid var(--hairline);
        }
        .masthead nav a {
          padding: 13px 0;
          font-size: 17px;
          color: var(--ink);
          border-radius: 0;
        }
        .masthead nav a:hover {
          background: none;
        }
        .masthead nav a[aria-current="page"] {
          color: var(--brand-deep);
          background: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .bars i {
          transition: none;
        }
      }

      .colophon {
        margin-top: clamp(80px, 11vw, 120px);
        border-top: var(--hair) solid var(--hairline);
        background: var(--raise);
      }
      .colophon-inner {
        max-width: calc(var(--page) + 2 * var(--edge));
        margin: 0 auto;
        padding: clamp(40px, 6vw, 64px) var(--edge) 28px;
        display: flex;
        flex-direction: column;
        gap: clamp(32px, 5vw, 48px);
      }
      .colophon-top {
        display: flex;
        flex-wrap: wrap;
        gap: 32px 56px;
        justify-content: space-between;
        align-items: flex-start;
      }
      .colophon-brand {
        flex: 1 1 340px;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .wordmark--large {
        font-weight: 750;
        font-stretch: 108%;
        font-size: 26px;
      }
      .wordmark--large :global(img) {
        width: 40px;
      }
      .colophon-brand p {
        margin: 0;
        font-size: 15px;
        line-height: 1.6;
        color: var(--graphite);
      }
      .colophon-brand strong {
        color: var(--ink);
        font-weight: 600;
      }
      .colophon-links {
        display: grid;
        grid-template-columns: repeat(2, minmax(140px, auto));
        gap: 12px 48px;
      }
      .colophon-links ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .colophon-links a {
        font-size: 15px;
        color: var(--ink);
        text-decoration: none;
      }
      .colophon-links a:hover {
        color: var(--brand-deep);
      }
      .colophon-bottom {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        padding-top: 20px;
        border-top: var(--hair) solid var(--hairline);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--mute);
      }
      .colophon-bottom a {
        text-decoration: none;
      }
    </style>
  </body>
</html>
