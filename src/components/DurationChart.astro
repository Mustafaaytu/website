---
/**
 * The edit loop, drawn at 1:1 real time.
 *
 * Each bar takes exactly as long to fill as the build it stands for took, once,
 * when it is scrolled to, with a control to run it again. An infinite loop
 * would turn a measurement into decoration.
 *
 * The bars are the fastest of the published sessions. The card around this
 * chart carries the ratio across all of them, which is the claim: the seconds
 * moved between sessions and the ratio held.
 *
 * SETTLED IS THE DEFAULT. Each bar's finished width is written into the built
 * HTML as an inline custom property and the stylesheet draws it, so with
 * scripts off this is a finished bar chart. The script only ever takes the
 * width away and gives it back at real speed.
 *
 * Nothing here is typed in. Every value comes from bench/site_facts.py.
 */
import facts from "../generated/facts.json";

const loop = facts.recorded.edit_loop;
const sessions = loop.sessions as Array<Record<string, number>>;
const series = loop.series as Array<{ key: string; label: string }>;

const rows = series.map(({ key, label }) => {
  const fast = Math.min(...sessions.map((s) => s[key]));
  return { key, label, fast };
});
const slowest = Math.max(...rows.map((r) => r.fast));
---

<div class="chart" data-slowest={String(slowest)}>
  <ol class="rows">
    {
      rows.map((row) => (
        <li class:list={["row", { win: row.key === "iyi" }]}>
          <code class="cmd">
            <span class="prompt">$ </span>
            {row.label}
          </code>
          <span class="reading">{row.fast.toFixed(2)} s</span>
          <div class="bar">
            <i style={`--to:${(row.fast / slowest) * 100}%;--dur:${row.fast}s`} />
          </div>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { playWhenSeen, reducedMotion } from "../lib/play-when-seen";

  // Run once when seen, and again on request. Reduced motion is honoured by
  // doing nothing at all rather than by animating faster: the animation IS the
  // measurement, so a shortened one would be a false reading.

  document.querySelectorAll<HTMLElement>(".chart").forEach((chart) => {
    if (reducedMotion()) return;

    // The replay control lives in the card's bar, which is the chart's
    // figure. It is hidden until this line: a control that cannot do anything
    // is not offered.
    const figure = chart.closest("figure") ?? chart;
    figure.setAttribute("data-chart", "ready");

    const play = () => {
      chart.classList.remove("waiting", "running");
      void chart.offsetWidth;
      chart.classList.add("running");
      const slowest = Number(chart.dataset.slowest ?? "0");
      window.setTimeout(() => chart.classList.remove("running"), slowest * 1000 + 60);
    };

    // The finished bars are what the HTML draws, for a reader with no
    // script. With one, the bars start empty and wait to be read, so a
    // reader scrolling past does not see the result before the run.
    chart.classList.add("waiting");

    figure.querySelector<HTMLButtonElement>("[data-replay]")?.addEventListener("click", play);

    playWhenSeen(chart, play);
  });
</script>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    font-size: 13.5px;
  }

  .cmd {
    font-size: 12.5px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .prompt {
    color: var(--mute);
    user-select: none;
  }

  .reading {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--graphite);
  }

  .win .reading {
    color: var(--ok);
  }

  .bar {
    grid-column: 1 / -1;
    height: 10px;
    border-radius: 999px;
    background: var(--raise);
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    width: var(--to);
    border-radius: 999px;
    background: var(--mute);
  }

  .win .bar i {
    background: var(--ok);
  }

  .chart.waiting .bar i {
    width: 0;
  }

  /* Real time: the bar takes exactly as long as the build took. */
  .chart.running .bar i {
    animation: grow var(--dur) linear forwards;
  }

  @keyframes grow {
    from {
      width: 0;
    }
    to {
      width: var(--to);
    }
  }
</style>
