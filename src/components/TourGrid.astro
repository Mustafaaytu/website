---
/**
 * The tour, in its sections: every step numbered, named and described by the
 * program's own first comment line, so the description cannot drift from the
 * file. Read out of samples/tour/tour.json through src/playground/samples.ts,
 * so a step this grid offers is a step that has a page and a recording.
 *
 * Shared by /learn/, where the tour is the second track, and /playground/,
 * where it is the whole page.
 */
import { runnable, tourSections } from "../playground/samples";
import { recordedText } from "../lib/highlight";
import { inlineMarkdown } from "../lib/lessons";

const base = import.meta.env.BASE_URL.replace(/\/*$/, "/");

const blurbOf = (path: string) => recordedText(path).split("\n")[0].replace(/^#\s*/, "");

let n = 0;
const sections = tourSections.map((section) => ({
  title: section.title,
  blurb: section.blurb,
  steps: section.steps.map((step) => ({
    n: ++n,
    id: step.id,
    href: `${base}playground/${step.id}/`,
    blurb: blurbOf(step.path),
    runs: runnable(step),
  })),
}));
---

<div class="tour">
  {
    sections.map((section) => (
      <section class="group">
        <header>
          <strong>{section.title}</strong>
          <span>{section.blurb}</span>
        </header>
        <ol>
          {section.steps.map((step) => (
            <li>
              <a href={step.href} data-step={step.id}>
                <i>{step.n}</i>
                <b>
                  {step.id}
                  {!step.runs && <>{" "}<em>recorded</em></>}
                </b>
                <span set:html={inlineMarkdown(step.blurb)} />
                {/* Filled by the playground's progress island, in this
                    browser only, and empty in the HTML. */}
                <small data-role="state"></small>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .tour {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
    align-items: start;
  }

  .group {
    border-radius: var(--radius-lg);
    border: var(--hair) solid var(--hairline);
    background: var(--card);
    overflow: hidden;
  }

  header {
    padding: 16px 18px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  header strong {
    font-weight: 650;
    font-size: 17px;
  }

  header span {
    font-size: 14px;
    color: var(--graphite);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 2px 10px;
    padding: 10px 18px;
    border-top: var(--hair) solid var(--hairline);
    color: var(--ink);
    text-decoration: none;
  }

  a:hover {
    background: var(--raise);
    color: var(--ink);
  }

  i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
    padding-top: 2px;
  }

  b {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13.5px;
  }

  em {
    font-style: normal;
    margin-left: 8px;
    font-size: 11px;
    color: var(--warn);
    font-family: var(--font-mono);
  }

  small {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ok);
  }

  small:empty {
    display: none;
  }

  span {
    grid-column: 2;
    font-size: 13.5px;
    color: var(--graphite);
  }
</style>
