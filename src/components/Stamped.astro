---
/**
 * A RECORDED measurement: seconds, bytes, milliseconds.
 *
 * These are a machine, not a language, so the headline is the RATIO, because
 * a ratio survives the machine. The absolute is demoted to the body, where it
 * sits next to its spread. The card's bar names it as measured and says what
 * it is a measurement of, which is what separates a recorded number from a
 * structural one at a glance: a structural number is set inline and has no
 * card.
 *
 * The card does not repeat its provenance. The record still has it and is
 * still gated: `scripts/facts.mjs` refuses to write `facts.json` when a
 * recorded group names no command or no machine, so every figure this
 * component renders is one whose box and command are written down in the
 * repository, and the colophon on every page names the generator and the
 * commit.
 *
 * Slots: `figure` draws above the claim (a chart, a pair of squares),
 * `action` sits at the right of the bar (a replay control), and the default
 * slot is the body under the claim.
 */
interface Props {
  /** The claim, machine-independent, stated large. */
  claim: string;
  /** The rest of the sentence, set under the claim at body weight. */
  tail?: string;
  /** What the claim is a claim about. */
  subject: string;
  /** Optional band, where a claim held across several readings. */
  band?: string;
  /** Marks a measurement iyi loses. Drives the signal colour. */
  outcome?: "win" | "loss" | "flat";
  /** Set the claim in the green a passing run is reported in. */
  accent?: boolean;
}

const { claim, tail, subject, band, outcome = "flat", accent = false } = Astro.props;

/* A figure reads at display size; a sentence would not fit at it. */
const long = claim.length > 26;
const hasFigure = Astro.slots.has("figure");
const hasBody = Astro.slots.has("default");
---

<figure class="card stamped" data-outcome={outcome}>
  <figcaption class="card__bar">
    <span>measured · {subject}</span>
    <slot name="action" />
  </figcaption>

  <slot name="figure" />

  <div class:list={["stat", { first: !hasFigure }]}>
    <p class:list={["claim", { long, ok: accent }]}>{claim}</p>
    {tail && <p class="tail">{tail}</p>}
    {band && <p class="p band">{band}</p>}
  </div>

  {
    hasBody && (
      <div class="stat body">
        <slot />
      </div>
    )
  }
</figure>

<style>
  .stamped {
    margin: 0;
  }

  .stat.first {
    border-top: 0;
  }

  .claim {
    margin: 0;
    font-weight: 750;
    font-stretch: 108%;
    font-size: clamp(36px, 4.6vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-wrap: balance;
  }

  .claim.long {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .claim.ok {
    color: var(--ok);
  }

  .stamped[data-outcome="loss"] .claim {
    color: var(--brand-deep);
  }

  .tail {
    margin: 0;
    font-weight: 600;
    font-size: 17px;
  }

  .band {
    margin-top: 4px;
  }

  .body :global(p) {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--graphite);
  }

  .body :global(p + p) {
    margin-top: 6px;
  }
</style>
